[
  {
    "desc": "기본 예제: 3개 변수 4개 절 (만족 가능)",
    "input": "3 4\n1 2\n-1 3\n-2 -3\n1 3",
    "expected_output": "1\n1 0 1"
  },
  {
    "desc": "명백한 모순: (x1 or x1) and (~x1 or ~x1) -> 불가능 (0)",
    "input": "1 2\n1 1\n-1 -1",
    "expected_output": "0"
  },
  {
    "desc": "단일 변수 만족 가능",
    "input": "1 1\n1 1",
    "expected_output": "1\n1"
  },
  {
    "desc": "2개 변수 상호 배타",
    "input": "2 3\n1 2\n-1 2\n-2 -2",
    "expected_output": "0"
  },
  {
    "desc": "모든 변수가 참이어야 하는 경우",
    "input": "3 3\n1 1\n2 2\n3 3",
    "expected_output": "1\n1 1 1"
  },
  {
    "desc": "순환 모순이 발생하는 2개 변수",
    "input": "2 4\n1 2\n-1 2\n1 -2\n-1 -2",
    "expected_output": "0"
  },
  {
    "desc": "체인 형태의 의존 관계",
    "input": "4 4\n-1 2\n-2 3\n-3 4\n-4 1",
    "expected_output": "1\n1 1 1 1"
  },
  {
    "desc": "독립된 변수들",
    "input": "3 2\n1 2\n2 3",
    "expected_output": "1\n1 1 1"
  },
  {
    "desc": "5개 변수 복합 2-SAT",
    "input": "5 6\n1 2\n-2 3\n-3 4\n-4 5\n-5 1\n2 4",
    "expected_output": "1\n1 1 1 1 1"
  },
  {
    "desc": "6개 변수 대규모 절",
    "input": "6 8\n1 2\n-1 3\n2 -4\n4 5\n-5 6\n-6 1\n3 -2\n-3 -4",
    "expected_output": "1\n1 1 1 0 1 1"
  }
]