[
  {
    "desc": "기본 예제: 10x10 정사각형 영역 -> 100.0",
    "input": "4\n0 0 10 0\n10 0 10 10\n10 10 0 10\n0 10 0 0",
    "expected_output": "100.0"
  },
  {
    "desc": "직각삼각형 영역 (밑변 4, 높이 3 -> 6.0)",
    "input": "3\n0 0 4 0\n4 0 0 3\n0 3 0 0",
    "expected_output": "6.0"
  },
  {
    "desc": "상호 모순되는 두 반평면 (교집합 없음 -> 0.0)",
    "input": "2\n0 0 10 0\n10 1 0 1",
    "expected_output": "2000.0"
  },
  {
    "desc": "기본 Bounding Box 2000x2000 전체가 유지되는 경우",
    "input": "1\n-1000 -1000 1000 -1000",
    "expected_output": "4000000.0"
  },
  {
    "desc": "마름모 형태 4개 반평면",
    "input": "4\n0 -5 5 0\n5 0 0 5\n0 5 -5 0\n-5 0 0 -5",
    "expected_output": "50.0"
  },
  {
    "desc": "직사각형 영역 (가로 20, 세로 10 -> 200.0)",
    "input": "4\n0 0 20 0\n20 0 20 10\n20 10 0 10\n0 10 0 0",
    "expected_output": "200.0"
  },
  {
    "desc": "정오각형 영역",
    "input": "5\n0 2 2 4\n2 4 4 3\n4 3 3 0\n3 0 1 0\n1 0 0 2",
    "expected_output": "0.0"
  },
  {
    "desc": "넓이가 0인 선분 교집합",
    "input": "2\n0 0 10 0\n10 0 0 0",
    "expected_output": "0.0"
  },
  {
    "desc": "육각형 영역 클리핑",
    "input": "6\n1 0 3 0\n3 0 4 2\n4 2 3 4\n3 4 1 4\n1 4 0 2\n0 2 1 0",
    "expected_output": "12.0"
  },
  {
    "desc": "복합 8개 반평면",
    "input": "8\n0 0 10 0\n10 0 10 10\n10 10 0 10\n0 10 0 0\n2 0 10 8\n8 10 0 2\n0 8 8 0\n10 2 2 10",
    "expected_output": "8.0"
  }
