[
  {
    "id": 1,
    "description": "기본 예제: [10, 20, 30, 40, 50], 쿼리 (1,3)->60, (2,4)->90, (3,5)->120",
    "input": "5 3\n10 20 30 40 50\n1 3\n2 4\n3 5\n",
    "expected_output": "60\n90\n120"
  },
  {
    "id": 2,
    "description": "단일 원소 구간 (L == R)",
    "input": "3 2\n5 15 25\n1 1\n3 3\n",
    "expected_output": "5\n25"
  },
  {
    "id": 3,
    "description": "전체 구간 (1 to N)",
    "input": "4 1\n1 2 3 4\n1 4\n",
    "expected_output": "10"
  },
  {
    "id": 4,
    "description": "음수 포함 수열",
    "input": "4 2\n10 -5 20 -10\n1 2\n2 4\n",
    "expected_output": "5\n5"
  },
  {
    "id": 5,
    "description": "원소 1개뿐인 수열",
    "input": "1 1\n42\n1 1\n",
    "expected_output": "42"
  },
  {
    "id": 6,
    "description": "모두 0인 수열",
    "input": "5 2\n0 0 0 0 0\n1 3\n2 5\n",
    "expected_output": "0\n0"
  },
  {
    "id": 7,
    "description": "연속된 음수 수열",
    "input": "3 2\n-1 -2 -3\n1 3\n2 3\n",
    "expected_output": "-6\n-5"
  },
  {
    "id": 8,
    "description": "큰 수 누적합",
    "input": "3 1\n1000 1000 1000\n1 3\n",
    "expected_output": "3000"
  },
  {
    "id": 9,
    "description": "여러 쿼리 복합",
    "input": "6 3\n1 2 3 4 5 6\n2 5\n1 6\n4 4\n",
    "expected_output": "14\n21\n4"
  },
  {
    "id": 10,
    "description": "부분 구간 덧셈",
    "input": "5 2\n2 4 6 8 10\n2 3\n3 5\n",
    "expected_output": "10\n24"
  }
]