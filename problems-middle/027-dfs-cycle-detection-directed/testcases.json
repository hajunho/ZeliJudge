[
  {
    "id": 1,
    "description": "기본 사이클 예제: 1->2->3->1 -> YES",
    "input": "3 3\n1 2\n2 3\n3 1\n",
    "expected_output": "YES"
  },
  {
    "id": 2,
    "description": "사이클 없는 일렬: 1->2->3 -> NO",
    "input": "3 2\n1 2\n2 3\n",
    "expected_output": "NO"
  },
  {
    "id": 3,
    "description": "간선 없는 그래프 (E = 0) -> NO",
    "input": "4 0\n",
    "expected_output": "NO"
  },
  {
    "id": 4,
    "description": "자가 루프(Self-loop): 1->1 -> YES",
    "input": "2 1\n1 1\n",
    "expected_output": "YES"
  },
  {
    "id": 5,
    "description": "다이아몬드 형태 (사이클 아님): 1->2, 1->3, 2->4, 3->4 -> NO",
    "input": "4 4\n1 2\n1 3\n2 4\n3 4\n",
    "expected_output": "NO"
  },
  {
    "id": 6,
    "description": "두 노드 상호 왕복: 1->2, 2->1 -> YES",
    "input": "2 2\n1 2\n2 1\n",
    "expected_output": "YES"
  },
  {
    "id": 7,
    "description": "떨어진 컴포넌트에 사이클 존재",
    "input": "4 2\n1 2\n3 4\n",
    "expected_output": "NO"
  },
  {
    "id": 8,
    "description": "떨어진 컴포넌트 사이클: 1-2 무사이클, 3->4->3 사이클",
    "input": "4 3\n1 2\n3 4\n4 3\n",
    "expected_output": "YES"
  },
  {
    "id": 9,
    "description": "긴 사이클 5개: 1->2->3->4->5->1",
    "input": "5 5\n1 2\n2 3\n3 4\n4 5\n5 1\n",
    "expected_output": "YES"
  },
  {
    "id": 10,
    "description": "트리 모양 단방향 그래프 -> NO",
    "input": "5 4\n1 2\n1 3\n2 4\n2 5\n",
    "expected_output": "NO"
  }
]