[
  {
    "desc": "기본 예제: 4x4 정사각형 -> 16.0",
    "input": "4\n0 0\n4 0\n4 4\n0 4",
    "expected_output": "16.0"
  },
  {
    "desc": "직각삼각형 (밑변 3, 높이 4) -> 6.0",
    "input": "3\n0 0\n3 0\n0 4",
    "expected_output": "6.0"
  },
  {
    "desc": "평행사변형 (밑변 5, 높이 3) -> 15.0",
    "input": "4\n0 0\n5 0\n7 3\n2 3",
    "expected_output": "15.0"
  },
  {
    "desc": "사다리꼴 ((3+5)*4/2 = 16.0)",
    "input": "4\n0 0\n5 0\n4 4\n1 4",
    "expected_output": "16.0"
  },
  {
    "desc": "음수 좌표를 포함하는 마름모 (대각선 6, 8 -> 넓이 24.0)",
    "input": "4\n3 0\n0 4\n-3 0\n0 -4",
    "expected_output": "24.0"
  },
  {
    "desc": "오목 다각형 (부메랑 모양)",
    "input": "4\n0 0\n4 1\n1 1\n1 4",
    "expected_output": "3.0"
  },
  {
    "desc": "소수점 .5가 나오는 삼각형",
    "input": "3\n0 0\n1 0\n0 1",
    "expected_output": "0.5"
  },
  {
    "desc": "정오각형 형태 꼭짓점들",
    "input": "5\n0 2\n2 4\n4 3\n3 0\n1 0",
    "expected_output": "10.5"
  },
  {
    "desc": "L자 모양 6각형 (면적 3.0)",
    "input": "6\n0 0\n2 0\n2 1\n1 1\n1 2\n0 2",
    "expected_output": "3.0"
  },
  {
    "desc": "8각형 복합 다각형",
    "input": "8\n1 0\n3 0\n4 1\n4 3\n3 4\n1 4\n0 3\n0 1",
    "expected_output": "14.0"
  }
]