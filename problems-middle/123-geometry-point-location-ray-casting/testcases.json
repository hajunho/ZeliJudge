[
  {
    "desc": "기본 예제: 10x10 정사각형 내부, 외부, 변 위",
    "input": "4\n0 0\n10 0\n10 10\n0 10\n3\n5 5\n15 5\n0 5",
    "expected_output": "IN\nOUT\nON"
  },
  {
    "desc": "삼각형 내부 점",
    "input": "3\n0 0\n6 0\n3 6\n1\n3 2",
    "expected_output": "IN"
  },
  {
    "desc": "꼭짓점 위에 위치한 점 (ON)",
    "input": "3\n0 0\n6 0\n3 6\n1\n0 0",
    "expected_output": "ON"
  },
  {
    "desc": "오목 다각형 (U자 형태)",
    "input": "8\n0 0\n6 0\n6 6\n4 6\n4 2\n2 2\n2 6\n0 6\n2\n3 1\n3 4",
    "expected_output": "IN\nOUT"
  },
  {
    "desc": "음수 좌표 다각형",
    "input": "4\n-5 -5\n5 -5\n5 5\n-5 5\n2\n0 0\n-10 0",
    "expected_output": "IN\nOUT"
  },
  {
    "desc": "다각형 바로 바깥 근접 점",
    "input": "4\n0 0\n4 0\n4 4\n0 4\n2\n5 2\n-1 2",
    "expected_output": "OUT\nOUT"
  },
  {
    "desc": "변의 연장선상에 있지만 변 밖인 점",
    "input": "4\n0 0\n2 0\n2 2\n0 2\n1\n5 0",
    "expected_output": "OUT"
  },
  {
    "desc": "다이아몬드 마름모",
    "input": "4\n0 4\n4 0\n0 -4\n-4 0\n2\n0 0\n2 2",
    "expected_output": "IN\nON"
  },
  {
    "desc": "5각형 내부 및 외부",
    "input": "5\n0 2\n2 4\n4 3\n3 0\n1 0\n2\n2 2\n0 0",
    "expected_output": "IN\nOUT"
  },
  {
    "desc": "복합 6개 질의",
    "input": "4\n1 1\n5 1\n5 5\n1 5\n6\n3 3\n1 3\n5 5\n0 0\n3 6\n5 3",
    "expected_output": "IN\nON\nON\nOUT\nOUT\nON"
  }
]