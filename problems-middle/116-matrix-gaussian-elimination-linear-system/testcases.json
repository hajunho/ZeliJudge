[
  {
    "desc": "기본 예제: 3x3 연립방정식 (2, 3, -1)",
    "input": "3\n2 1 -1 8\n-3 -1 2 -11\n-2 1 2 -3",
    "expected_output": "2.00 3.00 -1.00"
  },
  {
    "desc": "N=1 단일 방정식",
    "input": "1\n5 25",
    "expected_output": "5.00"
  },
  {
    "desc": "2x2 간단한 연립방정식 (x=1, y=2)",
    "input": "2\n1 1 3\n1 -1 -1",
    "expected_output": "1.00 2.00"
  },
  {
    "desc": "피봇팅이 필요한 경우 (첫 행 피봇이 0)",
    "input": "2\n0 2 6\n3 1 6",
    "expected_output": "1.00 3.00"
  },
  {
    "desc": "음수 해를 갖는 2x2",
    "input": "2\n2 3 -5\n1 -1 -5",
    "expected_output": "-4.00 1.00"
  },
  {
    "desc": "대각 행렬 (이미 정렬된 경우)",
    "input": "3\n2 0 0 4\n0 3 0 9\n0 0 4 16",
    "expected_output": "2.00 3.00 4.00"
  },
  {
    "desc": "분수 해를 갖는 경우",
    "input": "2\n3 4 5\n2 -1 1",
    "expected_output": "0.82 0.64"
  },
  {
    "desc": "4x4 연립일차방정식",
    "input": "4\n1 1 1 1 10\n1 -1 1 -1 2\n2 1 -1 3 13\n1 2 2 1 15",
    "expected_output": "5.00 4.00 1.00 0.00"
  },
  {
    "desc": "계수가 큰 방정식",
    "input": "3\n100 200 300 1400\n200 100 200 1100\n100 300 100 1100",
    "expected_output": "1.80 2.20 2.60"
  },
  {
    "desc": "복합 5x5 연립방정식",
    "input": "5\n1 2 3 4 5 35\n2 1 1 1 1 10\n3 2 1 2 1 16\n4 3 2 1 2 22\n5 4 3 2 1 28",
    "expected_output": "-0.50 4.25 2.25 2.25 2.25"
  }
]