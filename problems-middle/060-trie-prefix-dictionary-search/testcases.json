[
  {
    "id": 1,
    "description": "기본 예제: app->3, ban->2, cat->0",
    "input": "5 3\napple\napp\napplication\nbanana\nband\napp\nban\ncat\n",
    "expected_output": "3\n2\n0"
  },
  {
    "id": 2,
    "description": "단어 1개 검색",
    "input": "1 2\nhello\nhel\nhi\n",
    "expected_output": "1\n0"
  },
  {
    "id": 3,
    "description": "모든 단어가 같은 접두사 공유",
    "input": "3 2\naaa\naab\naac\na\naa\n",
    "expected_output": "3\n3"
  },
  {
    "id": 4,
    "description": "완전 일치 단어 검색",
    "input": "3 1\ncode\ncoding\ncoder\ncode\n",
    "expected_output": "2"
  },
  {
    "id": 5,
    "description": "한 글자 접두사",
    "input": "4 2\napple\nant\nbee\nbear\na\nb\n",
    "expected_output": "2\n2"
  },
  {
    "id": 6,
    "description": "사전에 없는 접두사",
    "input": "2 2\ncat\ndog\nz\nzebra\n",
    "expected_output": "0\n0"
  },
  {
    "id": 7,
    "description": "단어 자체가 접두사보다 짧은 경우",
    "input": "1 1\nhi\nhello\n",
    "expected_output": "0"
  },
  {
    "id": 8,
    "description": "접두사가 단어와 완전히 같은 경우",
    "input": "2 1\ntest\ntesting\ntest\n",
    "expected_output": "2"
  },
  {
    "id": 9,
    "description": "다양한 접두사 쿼리",
    "input": "4 3\nsuper\nsuperman\nsupreme\nsupport\nsuper\nsup\nsub\n",
    "expected_output": "2\n4\n0"
  },
  {
    "id": 10,
    "description": "긴 단어 사전",
    "input": "3 2\nalgorithm\nalgebra\naliasing\nalg\nal\n",
    "expected_output": "2\n3"
  }
]