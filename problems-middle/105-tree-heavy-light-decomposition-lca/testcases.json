  },
  {
    "desc": "스타 그래프 (모든 자식이 1에 연결)",
    "input": "5 3\n1 2\n1 3\n1 4\n1 5\n2 3\n4 5\n2 5",
    "expected_output": "1\n1\n1"
  },
  {
    "desc": "완전 이진 트리 7개 노드",
    "input": "7 4\n1 2\n1 3\n2 4\n2 5\n3 6\n3 7\n4 5\n6 7\n4 7\n2 7",
    "expected_output": "2\n3\n1\n1"
  },
  {
    "desc": "형제 노드끼리의 LCA",
    "input": "5 2\n1 2\n1 3\n2 4\n2 5\n4 5\n2 3",
