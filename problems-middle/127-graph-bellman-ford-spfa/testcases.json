[
  {
    "desc": "기본 예제: 4개 정점 음수 간선 포함 -> 0 4 3 1",
    "input": "4 4 1\n1 2 4\n1 3 3\n3 4 -2\n2 4 1",
    "expected_output": "0 4 3 1"
  },
  {
    "desc": "음수 사이클 존재: NEGATIVE CYCLE",
    "input": "3 3 1\n1 2 1\n2 3 -5\n3 2 2",
    "expected_output": "NEGATIVE CYCLE"
  },
  {
    "desc": "도달할 수 없는 노드 (INF)",
    "input": "3 1 1\n1 2 10",
    "expected_output": "0 10 INF"
  },
  {
    "desc": "노드 1개뿐인 그래프",
    "input": "1 0 1",
    "expected_output": "0"
  },
  {
    "desc": "양의 가중치만 있는 직선 경로",
    "input": "3 2 1\n1 2 5\n2 3 7",
    "expected_output": "0 5 12"
  },
  {
    "desc": "음수 간선이 있지만 사이클은 없는 경우",
    "input": "3 3 1\n1 2 -5\n2 3 -5\n1 3 0",
    "expected_output": "0 -5 -10"
  },
  {
    "desc": "다이아몬드 그래프 우회로",
    "input": "4 4 1\n1 2 10\n1 3 5\n2 4 10\n3 4 -2",
    "expected_output": "0 10 5 3"
  },
  {
    "desc": "출발지와 무관한 고립된 음수 사이클 (출발점 도달 불가)",
    "input": "4 3 1\n1 2 5\n3 4 -10\n4 3 2",
    "expected_output": "0 5 INF INF"
  },
  {
    "desc": "큰 가중치 간선들",
    "input": "3 2 1\n1 2 10000\n2 3 -5000",
    "expected_output": "0 10000 5000"
  },
  {
    "desc": "복합 5개 정점 도로망",
    "input": "5 6 1\n1 2 2\n1 3 5\n2 4 1\n3 4 -1\n4 5 3\n2 5 10",
    "expected_output": "0 2 5 3 6"
  }
]