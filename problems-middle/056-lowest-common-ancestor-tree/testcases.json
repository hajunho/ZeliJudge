    "expected_output": "3"
  },
  {
    "id": 5,
    "description": "스타 트리: 1에 2,3,4 연결 -> LCA는 1",
    "input": "4\n1 2\n1 3\n1 4\n1\n2 4\n",
    "expected_output": "1"
  },
  {
    "id": 6,
    "description": "형제 노드 간의 LCA",
    "input": "5\n1 2\n1 3\n2 4\n2 5\n1\n4 5\n",
    "expected_output": "2"
  },
  {
    "id": 7,
    "description": "서로 다른 깊이의 사촌 간 LCA",
    "input": "6\n1 2\n1 3\n2 4\n4 5\n3 6\n1\n5 6\n",
    "expected_output": "1"
  },
  {
    "id": 8,
    "description": "조부모와 손자 노드",
    "input": "5\n1 2\n2 3\n3 4\n4 5\n1\n2 5\n",
    "expected_output": "2"
  },
  {
    "id": 9,
    "description": "다중 쿼리 4개",
    "input": "5\n1 2\n1 3\n2 4\n3 5\n4\n4 5\n2 4\n3 5\n1 5\n",
    "expected_output": "1\n2\n3\n1"
  },
  {
    "id": 10,
    "description": "8개 노드 복합 트리",
    "input": "8\n1 2\n1 3\n2 4\n2 5\n5 6\n3 7\n7 8\n2\n6 4\n6 8\n",
    "expected_output": "2\n1"
  }
