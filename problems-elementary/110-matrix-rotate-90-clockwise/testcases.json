[
  {
    "id": 1,
    "description": "기본 2x3 회전 -> 3x2: 1 2 3 / 4 5 6 -> 4 1 / 5 2 / 6 3",
    "input": "2 3\n1 2 3\n4 5 6\n",
    "expected_output": "4 1\n5 2\n6 3"
  },
  {
    "id": 2,
    "description": "2x2 정사각 회전: 1 2 / 3 4 -> 3 1 / 4 2",
    "input": "2 2\n1 2\n3 4\n",
    "expected_output": "3 1\n4 2"
  },
  {
    "id": 3,
    "description": "1x1 단일 칸",
    "input": "1 1\n99\n",
    "expected_output": "99"
  },
  {
    "id": 4,
    "description": "1x3 가로 -> 3x1 세로",
    "input": "1 3\n1 2 3\n",
    "expected_output": "1\n2\n3"
  },
  {
    "id": 5,
    "description": "3x1 세로 -> 1x3 가로",
    "input": "3 1\n1\n2\n3\n",
    "expected_output": "3 2 1"
  },
  {
    "id": 6,
    "description": "3x3 행렬 회전",
    "input": "3 3\n1 2 3\n4 5 6\n7 8 9\n",
    "expected_output": "7 4 1\n8 5 2\n9 6 3"
  },
  {
    "id": 7,
    "description": "모두 동일한 원소",
    "input": "2 2\n0 0\n0 0\n",
    "expected_output": "0 0\n0 0"
  },
  {
    "id": 8,
    "description": "음수 포함 2x3",
    "input": "2 3\n-1 -2 -3\n-4 -5 -6\n",
    "expected_output": "-4 -1\n-5 -2\n-6 -3"
  },
  {
    "id": 9,
    "description": "3x2 -> 2x3",
    "input": "3 2\n1 2\n3 4\n5 6\n",
    "expected_output": "5 3 1\n6 4 2"
  },
  {
    "id": 10,
    "description": "4x2 -> 2x4",
    "input": "4 2\n1 2\n3 4\n5 6\n7 8\n",
    "expected_output": "7 5 3 1\n8 6 4 2"
  }
]