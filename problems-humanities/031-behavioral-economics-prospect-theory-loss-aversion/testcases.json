    "input": "{\"parameters\": {\"alpha\": 0.88, \"beta\": 0.88, \"lambda\": 2.25, \"gamma\": 0.61, \"delta\": 0.69}, \"operations\": [{\"id\": \"eval_gain\", \"op\": \"EVALUATE_PROSPECT\", \"reference_point\": 0.0, \"outcomes\": [{\"x\": 100.0, \"p\": 0.5}, {\"x\": 0.0, \"p\": 0.5}]}, {\"id\": \"eval_loss\", \"op\": \"EVALUATE_PROSPECT\", \"reference_point\": 0.0, \"outcomes\": [{\"x\": -100.0, \"p\": 0.5}, {\"x\": 0.0, \"p\": 0.5}]}]}",
