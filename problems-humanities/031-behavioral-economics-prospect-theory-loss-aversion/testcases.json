    "expected_output": "{\"results\": [{\"id\": \"fintech_pricing_framing\", \"op\": \"FRAMING_ANALYSIS\", \"positive_choice\": \"OPTION_A\", \"negative_choice\": \"OPTION_B\", \"positive_prospect_a\": 3.6239, \"positive_prospect_b\": 2.7685, \"negative_prospect_a\": -9.0597, \"negative_prospect_b\": -6.9211, \"preference_reversal\": true}, {\"id\": \"e_commerce_cashback_rebate\", \"op\": \"HEDONIC_EDITING\", \"events\": [-300.0, 10.0], \"net_outcome\": -290.0, \"segregated_value\": -233.3733, \"integrated_value\": -233.2697, \"optimal_strategy\": \"INTEGRATE\", \"hedonic_rule\": \"INTEGRATE_MIXED_LOSS\"}, {\"id\": \"fintech_micro_invest_prospect\", \"op\": \"EVALUATE_PROSPECT\", \"expected_value\": 111.0, \"prospect_value\": 1.0639, \"value_of_ev\": 6.8095, \"risk_attitude\": \"MIXED\"}]}"
