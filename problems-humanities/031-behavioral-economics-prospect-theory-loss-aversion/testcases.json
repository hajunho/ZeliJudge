  {
    "id": 7,
    "description": "Richard Thaler's 4 Hedonic Editing principles: segregating gains, integrating losses, integrating mixed gains, and the silver lining effect",
    "input": "{\"parameters\": {\"alpha\": 0.88, \"beta\": 0.88, \"lambda\": 2.25, \"gamma\": 0.61, \"delta\": 0.69}, \"operations\": [{\"id\": \"two_gains\", \"op\": \"HEDONIC_EDITING\", \"events\": [50.0, 25.0]}, {\"id\": \"two_losses\", \"op\": \"HEDONIC_EDITING\", \"events\": [-80.0, -20.0]}, {\"id\": \"mixed_gain\", \"op\": \"HEDONIC_EDITING\", \"events\": [100.0, -20.0]}, {\"id\": \"silver_lining\", \"op\": \"HEDONIC_EDITING\", \"events\": [1.0, -1000.0]}]}",
    "expected_output": "{\"results\": [{\"id\": \"two_gains\", \"op\": \"HEDONIC_EDITING\", \"events\": [50.0, 25.0], \"net_outcome\": 75.0, \"segregated_value\": 48.2573, \"integrated_value\": 44.6739, \"optimal_strategy\": \"SEGREGATE\", \"hedonic_rule\": \"SEGREGATE_MULTIPLE_GAINS\"}, {\"id\": \"two_losses\", \"op\": \"HEDONIC_EDITING\", \"events\": [-80.0, -20.0], \"net_outcome\": -100.0, \"segregated_value\": -137.8017, \"integrated_value\": -129.474, \"optimal_strategy\": \"INTEGRATE\", \"hedonic_rule\": \"INTEGRATE_MULTIPLE_LOSSES\"}, {\"id\": \"mixed_gain\", \"op\": \"HEDONIC_EDITING\", \"events\": [100.0, -20.0], \"net_outcome\": 80.0, \"segregated_value\": 26.1325, \"integrated_value\": 47.2845, \"optimal_strategy\": \"INTEGRATE\", \"hedonic_rule\": \"INTEGRATE_MIXED_GAIN\"}, {\"id\": \"silver_lining\", \"op\": \"HEDONIC_EDITING\", \"events\": [1.0, -1000.0], \"net_outcome\": -999.0, \"segregated_value\": -981.1606, \"integrated_value\": -981.2963, \"optimal_strategy\": \"SEGREGATE\", \"hedonic_rule\": \"SILVER_LINING\"}]}"
  },
