    "input": "{\"system\": {\"max_physical_frames\": 8}, \"operations\": [{\"step\": 1, \"op\": \"PROCESS_CREATE\", \"pid\": 60}, {\"step\": 2, \"op\": \"MMAP_ANONYMOUS\", \"pid\": 60, \"vpn_start\": 0, \"vpn_end\": 4, \"flags\": [\"READ\", \"WRITE\"]}, {\"step\": 3, \"op\": \"PAGE_WRITE\", \"pid\": 60, \"vpn\": 0, \"offset\": 0, \"val\": 1}, {\"step\": 4, \"op\": \"FORK\", \"parent_pid\": 60, \"child_pid\": 61}, {\"step\": 5, \"op\": \"PAGE_WRITE\", \"pid\": 61, \"vpn\": 0, \"offset\": 0, \"val\": 2}, {\"step\": 6, \"op\": \"PAGE_WRITE\", \"pid\": 61, \"vpn\": 1, \"offset\": 0, \"val\": 3}, {\"step\": 7, \"op\": \"PROCESS_EXIT\", \"pid\": 61}, {\"step\": 8, \"op\": \"PAGE_WRITE\", \"pid\": 60, \"vpn\": 0, \"offset\": 0, \"val\": 99}, {\"step\": 9, \"op\": \"PAGE_WRITE\", \"pid\": 60, \"vpn\": 2, \"offset\": 0, \"val\": 100}]}",
