    "input": "{\"config\": {\"sq_entries\": 8, \"cq_entries\": 16, \"sqpoll_enabled\": true, \"sq_thread_idle_ms\": 50}, \"files\": {\"4\": {\"size\": 2048}}, \"operations\": [{\"op_id\": 1, \"timestamp_ms\": 10, \"type\": \"SUBMIT_SQE\", \"opcode\": \"READ\", \"fd\": 4, \"offset\": 0, \"len\": 512, \"flags\": [], \"user_data\": 1}, {\"op_id\": 2, \"timestamp_ms\": 80, \"type\": \"SUBMIT_SQE\", \"opcode\": \"READ\", \"fd\": 4, \"offset\": 512, \"len\": 512, \"flags\": [], \"user_data\": 2}, {\"op_id\": 3, \"timestamp_ms\": 85, \"type\": \"DRAIN_CQE\", \"max_events\": 10}, {\"op_id\": 4, \"timestamp_ms\": 90, \"type\": \"ENTER_SYSCALL\", \"flags\": [\"IORING_ENTER_SQ_WAKEUP\"]}, {\"op_id\": 5, \"timestamp_ms\": 95, \"type\": \"DRAIN_CQE\", \"max_events\": 10}]}",
