    "id": 1,
    "description": "Zero-Syscall SQPOLL Continuous Execution: 100% Kernel Thread Polling without Enter Syscalls",
    "input": "{\"config\": {\"sq_entries\": 8, \"cq_entries\": 16, \"sqpoll_enabled\": true, \"sq_thread_idle_ms\": 100}, \"files\": {\"3\": {\"size\": 4096, \"data\": \"dummy_content\"}}, \"operations\": [{\"op_id\": 1, \"timestamp_ms\": 10, \"type\": \"SUBMIT_SQE\", \"opcode\": \"READ\", \"fd\": 3, \"offset\": 0, \"len\": 1024, \"flags\": [], \"user_data\": 1001}, {\"op_id\": 2, \"timestamp_ms\": 20, \"type\": \"SUBMIT_SQE\", \"opcode\": \"WRITE\", \"fd\": 3, \"offset\": 4096, \"len\": 512, \"flags\": [], \"user_data\": 1002}, {\"op_id\": 3, \"timestamp_ms\": 30, \"type\": \"SUBMIT_SQE\", \"opcode\": \"NOP\", \"fd\": 0, \"offset\": 0, \"len\": 0, \"flags\": [], \"user_data\": 1003}, {\"op_id\": 4, \"timestamp_ms\": 40, \"type\": \"DRAIN_CQE\", \"max_events\": 10}]}",
    "expected_output": "{\"summary\": {\"sqpoll_enabled\": true, \"total_sqes_submitted\": 3, \"total_cqes_posted\": 3, \"total_syscall_enters\": 0, \"zero_syscall_rate\": 1.0, \"final_sq_ring_empty\": true, \"final_cq_ring_pending\": 0}, \"drained_batches\": [{\"op_id\": 4, \"count\": 3, \"cqes\": [{\"user_data\": 1001, \"res\": 1024, \"flags\": 0}, {\"user_data\": 1002, \"res\": 512, \"flags\": 0}, {\"user_data\": 1003, \"res\": 0, \"flags\": 0}]}]}"
  },
