    "input": "{\n  \"system\": {\n    \"lock_mode\": \"LINUX_OFD_LOCKS\"\n  },\n  \"workload\": [\n    {\n      \"op\": \"OPEN\",\n      \"wallclock_ms\": 0.0,\n      \"pid\": 100,\n      \"thread_id\": \"worker_1\",\n      \"path\": \"/data/queue.dat\",\n      \"_returned_fd\": 3\n    },\n    {\n      \"op\": \"OPEN\",\n      \"wallclock_ms\": 5.0,\n      \"pid\": 100,\n      \"thread_id\": \"worker_2\",\n      \"path\": \"/data/queue.dat\",\n      \"_returned_fd\": 4\n    },\n    {\n      \"op\": \"LOCK\",\n      \"wallclock_ms\": 10.0,\n      \"pid\": 100,\n      \"thread_id\": \"worker_1\",\n      \"fd\": 3,\n      \"start\": 0,\n      \"length\": 4096\n    },\n    {\n      \"op\": \"WRITE\",\n      \"wallclock_ms\": 15.0,\n      \"pid\": 100,\n      \"thread_id\": \"worker_1\",\n      \"fd\": 3,\n      \"start\": 0,\n      \"length\": 4096,\n      \"payload\": \"MSG_1\"\n    },\n    {\n      \"op\": \"CLOSE\",\n      \"wallclock_ms\": 20.0,\n      \"pid\": 100,\n      \"thread_id\": \"worker_1\",\n      \"fd\": 3\n    },\n    {\n      \"op\": \"LOCK\",\n      \"wallclock_ms\": 25.0,\n      \"pid\": 100,\n      \"thread_id\": \"worker_2\",\n      \"fd\": 4,\n      \"start\": 0,\n      \"length\": 4096\n    },\n    {\n      \"op\": \"WRITE\",\n      \"wallclock_ms\": 30.0,\n      \"pid\": 100,\n      \"thread_id\": \"worker_2\",\n      \"fd\": 4,\n      \"start\": 0,\n      \"length\": 4096,\n      \"payload\": \"MSG_2\"\n    }\n  ]\n}",
    "output": "{\n  \"status\": \"SUCCESS\",\n  \"summary\": {\n    \"lock_mode\": \"LINUX_OFD_LOCKS\",\n    \"total_lock_requests\": 2,\n    \"locks_granted\": 2,\n    \"locks_denied\": 0,\n    \"silent_lock_drops\": 0,\n    \"database_corruptions\": 0\n  },\n  \"metrics\": {\n    \"total_lock_requests\": 2,\n    \"locks_granted\": 2,\n    \"locks_denied\": 0,\n    \"silent_lock_drops\": 0,\n    \"concurrent_write_conflicts\": 0,\n    \"database_corruptions\": 0,\n    \"active_locks_remaining\": 1,\n    \"verdict\": \"OPTIMAL_OFD_LOCK_RECORD_CONCURRENCY\"\n  },\n  \"sample_events\": [\n    {\n      \"wallclock_ms\": 0.0,\n      \"op\": \"OPEN\",\n      \"pid\": 100,\n      \"thread_id\": \"worker_1\",\n      \"fd\": 3,\n      \"path\": \"/data/queue.dat\"\n    },\n    {\n      \"wallclock_ms\": 5.0,\n      \"op\": \"OPEN\",\n      \"pid\": 100,\n      \"thread_id\": \"worker_2\",\n      \"fd\": 4,\n      \"path\": \"/data/queue.dat\"\n    },\n    {\n      \"wallclock_ms\": 10.0,\n      \"op\": \"LOCK\",\n      \"status\": \"GRANTED\",\n      \"fd\": 3,\n      \"range\": [\n        0,\n        4096\n      ]\n    },\n    {\n      \"wallclock_ms\": 15.0,\n      \"op\": \"WRITE\",\n      \"status\": \"SAFE_LOCKED_WRITE\",\n      \"fd\": 3,\n      \"range\": [\n        0,\n        4096\n      ]\n    },\n    {\n      \"wallclock_ms\": 20.0,\n      \"op\": \"CLOSE\",\n      \"fd\": 3\n    },\n    {\n      \"wallclock_ms\": 25.0,\n      \"op\": \"LOCK\",\n      \"status\": \"GRANTED\",\n      \"fd\": 4,\n      \"range\": [\n        0,\n        4096\n      ]\n    },\n    {\n      \"wallclock_ms\": 30.0,\n      \"op\": \"WRITE\",\n      \"status\": \"SAFE_LOCKED_WRITE\",\n      \"fd\": 4,\n      \"range\": [\n        0,\n        4096\n      ]\n    }\n  ]\n}"
