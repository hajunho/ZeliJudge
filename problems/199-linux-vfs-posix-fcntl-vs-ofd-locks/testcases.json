[
  {
    "id": 1,
    "description": "Linux OFD 락 멀티스레드 안전 동시성 (Optimal OFD Lock Record Concurrency) - 임시 fd close에도 기존 락 보존 및 독립 페이지 동시 쓰기 100% 성공",
    "input": "{\n  \"system\": {\n    \"lock_mode\": \"LINUX_OFD_LOCKS\"\n  },\n  \"workload\": [\n    {\n      \"op\": \"OPEN\",\n      \"wallclock_ms\": 0.0,\n      \"pid\": 100,\n      \"thread_id\": \"tx_writer_1\",\n      \"path\": \"/var/lib/db.sqlite\",\n      \"_returned_fd\": 3\n    },\n    {\n      \"op\": \"OPEN\",\n      \"wallclock_ms\": 5.0,\n      \"pid\": 100,\n      \"thread_id\": \"tx_writer_2\",\n      \"path\": \"/var/lib/db.sqlite\",\n      \"_returned_fd\": 4\n    },\n    {\n      \"op\": \"OPEN\",\n      \"wallclock_ms\": 10.0,\n      \"pid\": 100,\n      \"thread_id\": \"temp_reader\",\n      \"path\": \"/var/lib/db.sqlite\",\n      \"_returned_fd\": 5\n    },\n    {\n      \"op\": \"LOCK\",\n      \"wallclock_ms\": 15.0,\n      \"pid\": 100,\n      \"thread_id\": \"tx_writer_1\",\n      \"fd\": 3,\n      \"start\": 0,\n      \"length\": 4096\n    },\n    {\n      \"op\": \"LOCK\",\n      \"wallclock_ms\": 20.0,\n      \"pid\": 100,\n      \"thread_id\": \"tx_writer_2\",\n      \"fd\": 4,\n      \"start\": 4096,\n      \"length\": 4096\n    },\n    {\n      \"op\": \"CLOSE\",\n      \"wallclock_ms\": 25.0,\n      \"pid\": 100,\n      \"thread_id\": \"temp_reader\",\n      \"fd\": 5\n    },\n    {\n      \"op\": \"WRITE\",\n      \"wallclock_ms\": 30.0,\n      \"pid\": 100,\n      \"thread_id\": \"tx_writer_1\",\n      \"fd\": 3,\n      \"start\": 0,\n      \"length\": 4096,\n      \"payload\": \"COMMIT_PAGE_0\"\n    },\n    {\n      \"op\": \"WRITE\",\n      \"wallclock_ms\": 35.0,\n      \"pid\": 100,\n      \"thread_id\": \"tx_writer_2\",\n      \"fd\": 4,\n      \"start\": 4096,\n      \"length\": 4096,\n      \"payload\": \"COMMIT_PAGE_1\"\n    }\n  ]\n}",
    "output": "{\n  \"status\": \"SUCCESS\",\n  \"summary\": {\n    \"lock_mode\": \"LINUX_OFD_LOCKS\",\n    \"total_lock_requests\": 2,\n    \"locks_granted\": 2,\n    \"locks_denied\": 0,\n    \"silent_lock_drops\": 0,\n    \"database_corruptions\": 0\n  },\n  \"metrics\": {\n    \"total_lock_requests\": 2,\n    \"locks_granted\": 2,\n    \"locks_denied\": 0,\n    \"silent_lock_drops\": 0,\n    \"concurrent_write_conflicts\": 0,\n    \"database_corruptions\": 0,\n    \"active_locks_remaining\": 2,\n    \"verdict\": \"OPTIMAL_OFD_LOCK_RECORD_CONCURRENCY\"\n  },\n  \"sample_events\": [\n    {\n      \"wallclock_ms\": 0.0,\n      \"op\": \"OPEN\",\n      \"pid\": 100,\n      \"thread_id\": \"tx_writer_1\",\n      \"fd\": 3,\n      \"path\": \"/var/lib/db.sqlite\"\n    },\n    {\n      \"wallclock_ms\": 5.0,\n      \"op\": \"OPEN\",\n      \"pid\": 100,\n      \"thread_id\": \"tx_writer_2\",\n      \"fd\": 4,\n      \"path\": \"/var/lib/db.sqlite\"\n    },\n    {\n      \"wallclock_ms\": 10.0,\n      \"op\": \"OPEN\",\n      \"pid\": 100,\n      \"thread_id\": \"temp_reader\",\n      \"fd\": 5,\n      \"path\": \"/var/lib/db.sqlite\"\n    },\n    {\n      \"wallclock_ms\": 15.0,\n      \"op\": \"LOCK\",\n      \"status\": \"GRANTED\",\n      \"fd\": 3,\n      \"range\": [\n        0,\n        4096\n      ]\n    },\n    {\n      \"wallclock_ms\": 20.0,\n      \"op\": \"LOCK\",\n      \"status\": \"GRANTED\",\n      \"fd\": 4,\n      \"range\": [\n        4096,\n        4096\n      ]\n    },\n    {\n      \"wallclock_ms\": 25.0,\n      \"op\": \"CLOSE\",\n      \"fd\": 5\n    },\n    {\n      \"wallclock_ms\": 30.0,\n      \"op\": \"WRITE\",\n      \"status\": \"SAFE_LOCKED_WRITE\",\n      \"fd\": 3,\n      \"range\": [\n        0,\n        4096\n      ]\n    },\n    {\n      \"wallclock_ms\": 35.0,\n      \"op\": \"WRITE\",\n      \"status\": \"SAFE_LOCKED_WRITE\",\n      \"fd\": 4,\n      \"range\": [\n        4096,\n        4096\n      ]\n    }\n  ]\n}"
  },
  {
    "id": 2,
    "description": "POSIX fcntl 묵시적 잠금 해제 데이터베이스 오염 참사 (POSIX Silent Lock Drop Disaster) - 무관한 fd close로 메인 스레드 락이 강제 증발하여 비보호 쓰기 발생",
    "input": "{\n  \"system\": {\n    \"lock_mode\": \"POSIX_FCNTL_LOCKS\"\n  },\n  \"workload\": [\n    {\n      \"op\": \"OPEN\",\n      \"wallclock_ms\": 0.0,\n      \"pid\": 100,\n      \"thread_id\": \"main_writer\",\n      \"path\": \"/var/lib/db.sqlite\",\n      \"_returned_fd\": 3\n    },\n    {\n      \"op\": \"OPEN\",\n      \"wallclock_ms\": 5.0,\n      \"pid\": 100,\n      \"thread_id\": \"sub_inspector\",\n      \"path\": \"/var/lib/db.sqlite\",\n      \"_returned_fd\": 4\n    },\n    {\n      \"op\": \"LOCK\",\n      \"wallclock_ms\": 10.0,\n      \"pid\": 100,\n      \"thread_id\": \"main_writer\",\n      \"fd\": 3,\n      \"start\": 0,\n      \"length\": 4096\n    },\n    {\n      \"op\": \"CLOSE\",\n      \"wallclock_ms\": 20.0,\n      \"pid\": 100,\n      \"thread_id\": \"sub_inspector\",\n      \"fd\": 4\n    },\n    {\n      \"op\": \"WRITE\",\n      \"wallclock_ms\": 30.0,\n      \"pid\": 100,\n      \"thread_id\": \"main_writer\",\n      \"fd\": 3,\n      \"start\": 0,\n      \"length\": 4096,\n      \"payload\": \"CORRUPTED_COMMIT\"\n    }\n  ]\n}",
    "output": "{\n  \"status\": \"FAILED\",\n  \"summary\": {\n    \"lock_mode\": \"POSIX_FCNTL_LOCKS\",\n    \"total_lock_requests\": 1,\n    \"locks_granted\": 1,\n    \"locks_denied\": 0,\n    \"silent_lock_drops\": 1,\n    \"database_corruptions\": 1\n  },\n  \"metrics\": {\n    \"total_lock_requests\": 1,\n    \"locks_granted\": 1,\n    \"locks_denied\": 0,\n    \"silent_lock_drops\": 1,\n    \"concurrent_write_conflicts\": 1,\n    \"database_corruptions\": 1,\n    \"active_locks_remaining\": 0,\n    \"verdict\": \"DATABASE_CORRUPTION_POSIX_SILENT_LOCK_DROP\"\n  },\n  \"sample_events\": [\n    {\n      \"wallclock_ms\": 0.0,\n      \"op\": \"OPEN\",\n      \"pid\": 100,\n      \"thread_id\": \"main_writer\",\n      \"fd\": 3,\n      \"path\": \"/var/lib/db.sqlite\"\n    },\n    {\n      \"wallclock_ms\": 5.0,\n      \"op\": \"OPEN\",\n      \"pid\": 100,\n      \"thread_id\": \"sub_inspector\",\n      \"fd\": 4,\n      \"path\": \"/var/lib/db.sqlite\"\n    },\n    {\n      \"wallclock_ms\": 10.0,\n      \"op\": \"LOCK\",\n      \"status\": \"GRANTED\",\n      \"fd\": 3,\n      \"range\": [\n        0,\n        4096\n      ]\n    },\n    {\n      \"wallclock_ms\": 20.0,\n      \"op\": \"SILENT_LOCK_DROP_EVENT\",\n      \"victim_fd\": 3,\n      \"closed_fd\": 4,\n      \"range\": [\n        0,\n        4096\n      ],\n      \"desc\": \"Closing unrelated fd silently stripped POSIX lock from victim fd!\"\n    },\n    {\n      \"wallclock_ms\": 20.0,\n      \"op\": \"CLOSE\",\n      \"fd\": 4\n    },\n    {\n      \"wallclock_ms\": 30.0,\n      \"op\": \"WRITE\",\n      \"status\": \"UNPROTECTED_CORRUPTED_WRITE\",\n      \"fd\": 3,\n      \"range\": [\n        0,\n        4096\n      ],\n      \"reason\": \"Lock was silently dropped or never acquired!\"\n    }\n  ]\n}"
  },
  {
    "id": 3,
    "description": "BSD flock 전체 파일 조잡한 직렬화 병목 (BSD flock Coarse Serialization) - 바이트 범위 락 불가로 서로 다른 페이지 쓰기조차 전면 거부",
    "input": "{\n  \"system\": {\n    \"lock_mode\": \"BSD_FLOCK\"\n  },\n  \"workload\": [\n    {\n      \"op\": \"OPEN\",\n      \"wallclock_ms\": 0.0,\n      \"pid\": 100,\n      \"thread_id\": \"worker_A\",\n      \"path\": \"/data/ledger.db\",\n      \"_returned_fd\": 3\n    },\n    {\n      \"op\": \"OPEN\",\n      \"wallclock_ms\": 5.0,\n      \"pid\": 100,\n      \"thread_id\": \"worker_B\",\n      \"path\": \"/data/ledger.db\",\n      \"_returned_fd\": 4\n    },\n    {\n      \"op\": \"OPEN\",\n      \"wallclock_ms\": 10.0,\n      \"pid\": 100,\n      \"thread_id\": \"worker_C\",\n      \"path\": \"/data/ledger.db\",\n      \"_returned_fd\": 5\n    },\n    {\n      \"op\": \"LOCK\",\n      \"wallclock_ms\": 15.0,\n      \"pid\": 100,\n      \"thread_id\": \"worker_A\",\n      \"fd\": 3,\n      \"start\": 0,\n      \"length\": 4096\n    },\n    {\n      \"op\": \"LOCK\",\n      \"wallclock_ms\": 20.0,\n      \"pid\": 100,\n      \"thread_id\": \"worker_B\",\n      \"fd\": 4,\n      \"start\": 4096,\n      \"length\": 4096\n    },\n    {\n      \"op\": \"LOCK\",\n      \"wallclock_ms\": 25.0,\n      \"pid\": 100,\n      \"thread_id\": \"worker_C\",\n      \"fd\": 5,\n      \"start\": 8192,\n      \"length\": 4096\n    }\n  ]\n}",
    "output": "{\n  \"status\": \"FAILED\",\n  \"summary\": {\n    \"lock_mode\": \"BSD_FLOCK\",\n    \"total_lock_requests\": 3,\n    \"locks_granted\": 1,\n    \"locks_denied\": 2,\n    \"silent_lock_drops\": 0,\n    \"database_corruptions\": 0\n  },\n  \"metrics\": {\n    \"total_lock_requests\": 3,\n    \"locks_granted\": 1,\n    \"locks_denied\": 2,\n    \"silent_lock_drops\": 0,\n    \"concurrent_write_conflicts\": 0,\n    \"database_corruptions\": 0,\n    \"active_locks_remaining\": 1,\n    \"verdict\": \"FLOCK_COARSE_GRAINED_SERIALIZATION_BOTTLENECK\"\n  },\n  \"sample_events\": [\n    {\n      \"wallclock_ms\": 0.0,\n      \"op\": \"OPEN\",\n      \"pid\": 100,\n      \"thread_id\": \"worker_A\",\n      \"fd\": 3,\n      \"path\": \"/data/ledger.db\"\n    },\n    {\n      \"wallclock_ms\": 5.0,\n      \"op\": \"OPEN\",\n      \"pid\": 100,\n      \"thread_id\": \"worker_B\",\n      \"fd\": 4,\n      \"path\": \"/data/ledger.db\"\n    },\n    {\n      \"wallclock_ms\": 10.0,\n      \"op\": \"OPEN\",\n      \"pid\": 100,\n      \"thread_id\": \"worker_C\",\n      \"fd\": 5,\n      \"path\": \"/data/ledger.db\"\n    },\n    {\n      \"wallclock_ms\": 15.0,\n      \"op\": \"LOCK\",\n      \"status\": \"GRANTED\",\n      \"fd\": 3\n    },\n    {\n      \"wallclock_ms\": 20.0,\n      \"op\": \"LOCK\",\n      \"status\": \"DENIED\",\n      \"fd\": 4,\n      \"reason\": \"FLOCK_WHOLE_FILE_BUSY\"\n    },\n    {\n      \"wallclock_ms\": 25.0,\n      \"op\": \"LOCK\",\n      \"status\": \"DENIED\",\n      \"fd\": 5,\n      \"reason\": \"FLOCK_WHOLE_FILE_BUSY\"\n    }\n  ]\n}"
  },
  {
    "id": 4,
    "description": "멀티 프로세스 간 OFD 배타 잠금 상호 배제 (Multi-Process OFD Mutual Exclusion) - 동일 범위에 대해 서로 다른 프로세스의 중복 획득 완벽 차단",
    "input": "{\n  \"system\": {\n    \"lock_mode\": \"LINUX_OFD_LOCKS\"\n  },\n  \"workload\": [\n    {\n      \"op\": \"OPEN\",\n      \"wallclock_ms\": 0.0,\n      \"pid\": 1001,\n      \"thread_id\": \"proc1_t1\",\n      \"path\": \"/data/storage.bin\",\n      \"_returned_fd\": 3\n    },\n    {\n      \"op\": \"OPEN\",\n      \"wallclock_ms\": 5.0,\n      \"pid\": 1002,\n      \"thread_id\": \"proc2_t1\",\n      \"path\": \"/data/storage.bin\",\n      \"_returned_fd\": 4\n    },\n    {\n      \"op\": \"LOCK\",\n      \"wallclock_ms\": 10.0,\n      \"pid\": 1001,\n      \"thread_id\": \"proc1_t1\",\n      \"fd\": 3,\n      \"start\": 0,\n      \"length\": 4096\n    },\n    {\n      \"op\": \"LOCK\",\n      \"wallclock_ms\": 15.0,\n      \"pid\": 1002,\n      \"thread_id\": \"proc2_t1\",\n      \"fd\": 4,\n      \"start\": 0,\n      \"length\": 4096\n    },\n    {\n      \"op\": \"WRITE\",\n      \"wallclock_ms\": 20.0,\n      \"pid\": 1001,\n      \"thread_id\": \"proc1_t1\",\n      \"fd\": 3,\n      \"start\": 0,\n      \"length\": 4096,\n      \"payload\": \"PROC1_EXCLUSIVE_DATA\"\n    }\n  ]\n}",
    "output": "{\n  \"status\": \"SUCCESS\",\n  \"summary\": {\n    \"lock_mode\": \"LINUX_OFD_LOCKS\",\n    \"total_lock_requests\": 2,\n    \"locks_granted\": 1,\n    \"locks_denied\": 1,\n    \"silent_lock_drops\": 0,\n    \"database_corruptions\": 0\n  },\n  \"metrics\": {\n    \"total_lock_requests\": 2,\n    \"locks_granted\": 1,\n    \"locks_denied\": 1,\n    \"silent_lock_drops\": 0,\n    \"concurrent_write_conflicts\": 0,\n    \"database_corruptions\": 0,\n    \"active_locks_remaining\": 1,\n    \"verdict\": \"OPTIMAL_OFD_LOCK_RECORD_CONCURRENCY\"\n  },\n  \"sample_events\": [\n    {\n      \"wallclock_ms\": 0.0,\n      \"op\": \"OPEN\",\n      \"pid\": 1001,\n      \"thread_id\": \"proc1_t1\",\n      \"fd\": 3,\n      \"path\": \"/data/storage.bin\"\n    },\n    {\n      \"wallclock_ms\": 5.0,\n      \"op\": \"OPEN\",\n      \"pid\": 1002,\n      \"thread_id\": \"proc2_t1\",\n      \"fd\": 4,\n      \"path\": \"/data/storage.bin\"\n    },\n    {\n      \"wallclock_ms\": 10.0,\n      \"op\": \"LOCK\",\n      \"status\": \"GRANTED\",\n      \"fd\": 3,\n      \"range\": [\n        0,\n        4096\n      ]\n    },\n    {\n      \"wallclock_ms\": 15.0,\n      \"op\": \"LOCK\",\n      \"status\": \"DENIED\",\n      \"fd\": 4,\n      \"reason\": \"OFD_OVERLAPPING_DIFFERENT_FILE_DESC\"\n    },\n    {\n      \"wallclock_ms\": 20.0,\n      \"op\": \"WRITE\",\n      \"status\": \"SAFE_LOCKED_WRITE\",\n      \"fd\": 3,\n      \"range\": [\n        0,\n        4096\n      ]\n    }\n  ]\n}"
  },
  {
    "id": 5,
