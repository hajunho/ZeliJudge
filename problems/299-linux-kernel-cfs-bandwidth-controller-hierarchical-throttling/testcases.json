  {
    "id": "case01_basic_cfs_quota_consumption_and_refill",
    "description": "Single CPU executes task within quota; period timer replenishes quota at boundary",
    "input": "{\"config\": {\"period_us\": 100000, \"quota_us\": 50000, \"slice_us\": 5000, \"num_cpus\": 2}, \"actions\": [{\"type\": \"RUN_TASK\", \"time_us\": 10000, \"cpu_id\": 0, \"duration_us\": 20000}, {\"type\": \"ADVANCE_TIME\", \"time_us\": 100000}, {\"type\": \"RUN_TASK\", \"time_us\": 110000, \"cpu_id\": 0, \"duration_us\": 20000}]}",
    "expected_output": "{\"history\": [{\"time_us\": 10000, \"event\": \"TASK_EXEC\", \"cpu_id\": 0, \"requested_us\": 20000, \"executed_us\": 20000, \"status\": \"COMPLETED\"}, {\"time_us\": 100000, \"event\": \"PERIOD_EXPIRED_REFILL\", \"period\": 1, \"refilled_runtime\": 50000, \"burst_buffer\": 0, \"unthrottled_cpus\": []}, {\"time_us\": 110000, \"event\": \"TASK_EXEC\", \"cpu_id\": 0, \"requested_us\": 20000, \"executed_us\": 20000, \"status\": \"COMPLETED\"}], \"stats\": {\"periods\": 1, \"nr_throttled\": 0, \"throttled_time_us\": 0, \"total_runtime_consumed\": 40000, \"burst_used_us\": 0}, \"final_state\": {\"current_time_us\": 110000, \"periods_elapsed\": 1, \"runtime_remaining_us\": 30000, \"burst_buffer_us\": 0, \"cpus\": {\"0\": {\"slice_us\": 0, \"throttled\": false, \"total_executed_us\": 40000}, \"1\": {\"slice_us\": 0, \"throttled\": false, \"total_executed_us\": 0}}}}"
  },
