  {
    "id": "case05_dynamic_endpoint_roaming",
    "description": "모바일 클라이언트의 Wi-Fi에서 5G LTE 망 전환 시 동적 엔드포인트 로밍(Roaming) 자동 갱신",
    "input": "{\"config\": {\"replay_window_size\": 64, \"rekey_after_time_s\": 120.0, \"rekey_after_packets\": 500, \"reject_after_time_s\": 180.0}, \"peers\": [{\"peer_id\": \"peer_mobile_client\", \"public_key\": \"pk_mob\", \"allowed_ips\": [\"10.200.0.5/32\"], \"endpoint\": \"198.51.100.99:51820\"}], \"events\": [{\"type\": \"HANDSHAKE\", \"time_s\": 0.0, \"peer_id\": \"peer_mobile_client\", \"session_id\": \"sess_mob_01\"}, {\"type\": \"RX\", \"time_s\": 1.0, \"src_endpoint\": \"198.51.100.99:51820\", \"inner_src_ip\": \"10.200.0.5\", \"inner_dst_ip\": \"10.0.0.1\", \"counter\": 1, \"session_id\": \"sess_mob_01\"}, {\"type\": \"RX\", \"time_s\": 5.0, \"src_endpoint\": \"203.0.113.77:45120\", \"inner_src_ip\": \"10.200.0.5\", \"inner_dst_ip\": \"10.0.0.1\", \"counter\": 2, \"session_id\": \"sess_mob_01\"}, {\"type\": \"TX\", \"time_s\": 6.0, \"dst_ip\": \"10.200.0.5\", \"payload_len\": 500}]}",
    "expected_output": "{\"metrics\":{\"tx_forwarded\":1,\"rx_accepted\":2,\"dropped_unroutable\":0,\"dropped_spoofed_src\":0,\"dropped_replay_duplicate\":0,\"dropped_counter_too_old\":0,\"rekey_handshakes\":1,\"endpoint_roaming_updates\":1},\"peer_summaries\":{\"peer_mobile_client\":{\"current_endpoint\":\"203.0.113.77:45120\",\"active_session_id\":\"sess_mob_01\",\"tx_packets\":1,\"rx_packets\":2,\"rx_max_counter\":2,\"rekey_count\":1}},\"diagnostics\":{\"status\":\"SECURE_OPTIMAL\",\"anomalies\":[]},\"event_log_sample\":[{\"time_s\":0.0,\"event\":\"HANDSHAKE_ESTABLISHED\",\"peer_id\":\"peer_mobile_client\",\"session_id\":\"sess_mob_01\"},{\"time_s\":1.0,\"event\":\"RX_ACCEPT\",\"peer_id\":\"peer_mobile_client\",\"inner_src_ip\":\"10.200.0.5\",\"inner_dst_ip\":\"10.0.0.1\",\"counter\":1},{\"time_s\":5.0,\"event\":\"ROAMING_ENDPOINT_UPDATE\",\"peer_id\":\"peer_mobile_client\",\"old_endpoint\":\"198.51.100.99:51820\",\"new_endpoint\":\"203.0.113.77:45120\"},{\"time_s\":5.0,\"event\":\"RX_ACCEPT\",\"peer_id\":\"peer_mobile_client\",\"inner_src_ip\":\"10.200.0.5\",\"inner_dst_ip\":\"10.0.0.1\",\"counter\":2},{\"time_s\":6.0,\"event\":\"TX_FORWARD\",\"peer_id\":\"peer_mobile_client\",\"dst_ip\":\"10.200.0.5\",\"endpoint\":\"203.0.113.77:45120\",\"counter\":1,\"rekey_required\":false}]}"
