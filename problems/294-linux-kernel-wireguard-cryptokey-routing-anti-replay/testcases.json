[
  {
    "id": "case01_ideal_bidirectional_traffic",
    "description": "이상적인 단일 피어 양방향 통신 (순차 카운터, AllowedIPs 완벽 매칭, 100% 정상 수락)",
    "input": "{\"config\": {\"replay_window_size\": 64, \"rekey_after_time_s\": 120.0, \"rekey_after_packets\": 500, \"reject_after_time_s\": 180.0}, \"peers\": [{\"peer_id\": \"peer_frankfurt\", \"public_key\": \"pk_fra\", \"allowed_ips\": [\"10.0.1.0/24\"], \"endpoint\": \"198.51.100.10:51820\"}], \"events\": [{\"type\": \"HANDSHAKE\", \"time_s\": 0.0, \"peer_id\": \"peer_frankfurt\", \"session_id\": \"sess_fra_01\"}, {\"type\": \"TX\", \"time_s\": 1.0, \"dst_ip\": \"10.0.1.10\", \"payload_len\": 1420}, {\"type\": \"TX\", \"time_s\": 1.5, \"dst_ip\": \"10.0.1.20\", \"payload_len\": 1420}, {\"type\": \"RX\", \"time_s\": 2.0, \"src_endpoint\": \"198.51.100.10:51820\", \"inner_src_ip\": \"10.0.1.10\", \"inner_dst_ip\": \"10.0.2.1\", \"counter\": 1, \"session_id\": \"sess_fra_01\"}, {\"type\": \"RX\", \"time_s\": 2.5, \"src_endpoint\": \"198.51.100.10:51820\", \"inner_src_ip\": \"10.0.1.20\", \"inner_dst_ip\": \"10.0.2.1\", \"counter\": 2, \"session_id\": \"sess_fra_01\"}, {\"type\": \"RX\", \"time_s\": 3.0, \"src_endpoint\": \"198.51.100.10:51820\", \"inner_src_ip\": \"10.0.1.30\", \"inner_dst_ip\": \"10.0.2.1\", \"counter\": 3, \"session_id\": \"sess_fra_01\"}]}",
    "expected_output": "{\"metrics\":{\"tx_forwarded\":2,\"rx_accepted\":3,\"dropped_unroutable\":0,\"dropped_spoofed_src\":0,\"dropped_replay_duplicate\":0,\"dropped_counter_too_old\":0,\"rekey_handshakes\":1,\"endpoint_roaming_updates\":0},\"peer_summaries\":{\"peer_frankfurt\":{\"current_endpoint\":\"198.51.100.10:51820\",\"active_session_id\":\"sess_fra_01\",\"tx_packets\":2,\"rx_packets\":3,\"rx_max_counter\":3,\"rekey_count\":1}},\"diagnostics\":{\"status\":\"SECURE_OPTIMAL\",\"anomalies\":[]},\"event_log_sample\":[{\"time_s\":0.0,\"event\":\"HANDSHAKE_ESTABLISHED\",\"peer_id\":\"peer_frankfurt\",\"session_id\":\"sess_fra_01\"},{\"time_s\":1.0,\"event\":\"TX_FORWARD\",\"peer_id\":\"peer_frankfurt\",\"dst_ip\":\"10.0.1.10\",\"endpoint\":\"198.51.100.10:51820\",\"counter\":1,\"rekey_required\":false},{\"time_s\":1.5,\"event\":\"TX_FORWARD\",\"peer_id\":\"peer_frankfurt\",\"dst_ip\":\"10.0.1.20\",\"endpoint\":\"198.51.100.10:51820\",\"counter\":2,\"rekey_required\":false},{\"time_s\":2.0,\"event\":\"RX_ACCEPT\",\"peer_id\":\"peer_frankfurt\",\"inner_src_ip\":\"10.0.1.10\",\"inner_dst_ip\":\"10.0.2.1\",\"counter\":1},{\"time_s\":2.5,\"event\":\"RX_ACCEPT\",\"peer_id\":\"peer_frankfurt\",\"inner_src_ip\":\"10.0.1.20\",\"inner_dst_ip\":\"10.0.2.1\",\"counter\":2},{\"time_s\":3.0,\"event\":\"RX_ACCEPT\",\"peer_id\":\"peer_frankfurt\",\"inner_src_ip\":\"10.0.1.30\",\"inner_dst_ip\":\"10.0.2.1\",\"counter\":3}]}"
  },
  {
    "id": "case02_anti_replay_duplicate_attack",
    "description": "중간자 공격자에 의한 과거 유효 패킷 재전송(Replay Attack) 시 비트맵 기반 즉각 차단",
    "input": "{\"config\": {\"replay_window_size\": 64, \"rekey_after_time_s\": 120.0, \"rekey_after_packets\": 500, \"reject_after_time_s\": 180.0}, \"peers\": [{\"peer_id\": \"peer_seoul\", \"public_key\": \"pk_sel\", \"allowed_ips\": [\"172.16.1.0/24\"], \"endpoint\": \"203.0.113.1:51820\"}], \"events\": [{\"type\": \"HANDSHAKE\", \"time_s\": 0.0, \"peer_id\": \"peer_seoul\", \"session_id\": \"sess_sel_01\"}, {\"type\": \"RX\", \"time_s\": 1.0, \"src_endpoint\": \"203.0.113.1:51820\", \"inner_src_ip\": \"172.16.1.5\", \"inner_dst_ip\": \"10.0.0.1\", \"counter\": 10, \"session_id\": \"sess_sel_01\"}, {\"type\": \"RX\", \"time_s\": 1.2, \"src_endpoint\": \"203.0.113.1:51820\", \"inner_src_ip\": \"172.16.1.5\", \"inner_dst_ip\": \"10.0.0.1\", \"counter\": 11, \"session_id\": \"sess_sel_01\"}, {\"type\": \"RX\", \"time_s\": 1.5, \"src_endpoint\": \"203.0.113.1:51820\", \"inner_src_ip\": \"172.16.1.5\", \"inner_dst_ip\": \"10.0.0.1\", \"counter\": 10, \"session_id\": \"sess_sel_01\"}, {\"type\": \"RX\", \"time_s\": 1.8, \"src_endpoint\": \"203.0.113.1:51820\", \"inner_src_ip\": \"172.16.1.5\", \"inner_dst_ip\": \"10.0.0.1\", \"counter\": 11, \"session_id\": \"sess_sel_01\"}]}",
    "expected_output": "{\"metrics\":{\"tx_forwarded\":0,\"rx_accepted\":2,\"dropped_unroutable\":0,\"dropped_spoofed_src\":0,\"dropped_replay_duplicate\":2,\"dropped_counter_too_old\":0,\"rekey_handshakes\":1,\"endpoint_roaming_updates\":0},\"peer_summaries\":{\"peer_seoul\":{\"current_endpoint\":\"203.0.113.1:51820\",\"active_session_id\":\"sess_sel_01\",\"tx_packets\":0,\"rx_packets\":2,\"rx_max_counter\":11,\"rekey_count\":1}},\"diagnostics\":{\"status\":\"SECURITY_INCIDENT_REPLAY\",\"anomalies\":[\"REPLAY_ATTACK_DETECTED\"]},\"event_log_sample\":[{\"time_s\":0.0,\"event\":\"HANDSHAKE_ESTABLISHED\",\"peer_id\":\"peer_seoul\",\"session_id\":\"sess_sel_01\"},{\"time_s\":1.0,\"event\":\"RX_ACCEPT\",\"peer_id\":\"peer_seoul\",\"inner_src_ip\":\"172.16.1.5\",\"inner_dst_ip\":\"10.0.0.1\",\"counter\":10},{\"time_s\":1.2,\"event\":\"RX_ACCEPT\",\"peer_id\":\"peer_seoul\",\"inner_src_ip\":\"172.16.1.5\",\"inner_dst_ip\":\"10.0.0.1\",\"counter\":11},{\"time_s\":1.5,\"event\":\"RX_DROP\",\"reason\":\"REPLAY_ATTACK_DUPLICATE\",\"counter\":10},{\"time_s\":1.8,\"event\":\"RX_DROP\",\"reason\":\"REPLAY_ATTACK_DUPLICATE\",\"counter\":11}]}"
  },
  {
    "id": "case03_anti_replay_old_packet_lag",
    "description": "네트워크 지연으로 윈도우 크기(64) 이전의 오래된 카운터 패킷 유입 시 COUNTER_TOO_OLD 폐기",
    "input": "{\"config\": {\"replay_window_size\": 64, \"rekey_after_time_s\": 120.0, \"rekey_after_packets\": 500, \"reject_after_time_s\": 180.0}, \"peers\": [{\"peer_id\": \"peer_tokyo\", \"public_key\": \"pk_tyo\", \"allowed_ips\": [\"192.168.10.0/24\"], \"endpoint\": \"198.51.100.55:51820\"}], \"events\": [{\"type\": \"HANDSHAKE\", \"time_s\": 0.0, \"peer_id\": \"peer_tokyo\", \"session_id\": \"sess_tyo_01\"}, {\"type\": \"RX\", \"time_s\": 1.0, \"src_endpoint\": \"198.51.100.55:51820\", \"inner_src_ip\": \"192.168.10.2\", \"inner_dst_ip\": \"10.0.0.1\", \"counter\": 10, \"session_id\": \"sess_tyo_01\"}, {\"type\": \"RX\", \"time_s\": 2.0, \"src_endpoint\": \"198.51.100.55:51820\", \"inner_src_ip\": \"192.168.10.2\", \"inner_dst_ip\": \"10.0.0.1\", \"counter\": 100, \"session_id\": \"sess_tyo_01\"}, {\"type\": \"RX\", \"time_s\": 2.2, \"src_endpoint\": \"198.51.100.55:51820\", \"inner_src_ip\": \"192.168.10.2\", \"inner_dst_ip\": \"10.0.0.1\", \"counter\": 80, \"session_id\": \"sess_tyo_01\"}, {\"type\": \"RX\", \"time_s\": 2.5, \"src_endpoint\": \"198.51.100.55:51820\", \"inner_src_ip\": \"192.168.10.2\", \"inner_dst_ip\": \"10.0.0.1\", \"counter\": 30, \"session_id\": \"sess_tyo_01\"}]}",
    "expected_output": "{\"metrics\":{\"tx_forwarded\":0,\"rx_accepted\":3,\"dropped_unroutable\":0,\"dropped_spoofed_src\":0,\"dropped_replay_duplicate\":0,\"dropped_counter_too_old\":1,\"rekey_handshakes\":1,\"endpoint_roaming_updates\":0},\"peer_summaries\":{\"peer_tokyo\":{\"current_endpoint\":\"198.51.100.55:51820\",\"active_session_id\":\"sess_tyo_01\",\"tx_packets\":0,\"rx_packets\":3,\"rx_max_counter\":100,\"rekey_count\":1}},\"diagnostics\":{\"status\":\"SECURE_OPTIMAL\",\"anomalies\":[]},\"event_log_sample\":[{\"time_s\":0.0,\"event\":\"HANDSHAKE_ESTABLISHED\",\"peer_id\":\"peer_tokyo\",\"session_id\":\"sess_tyo_01\"},{\"time_s\":1.0,\"event\":\"RX_ACCEPT\",\"peer_id\":\"peer_tokyo\",\"inner_src_ip\":\"192.168.10.2\",\"inner_dst_ip\":\"10.0.0.1\",\"counter\":10},{\"time_s\":2.0,\"event\":\"RX_ACCEPT\",\"peer_id\":\"peer_tokyo\",\"inner_src_ip\":\"192.168.10.2\",\"inner_dst_ip\":\"10.0.0.1\",\"counter\":100},{\"time_s\":2.2,\"event\":\"RX_ACCEPT\",\"peer_id\":\"peer_tokyo\",\"inner_src_ip\":\"192.168.10.2\",\"inner_dst_ip\":\"10.0.0.1\",\"counter\":80},{\"time_s\":2.5,\"event\":\"RX_DROP\",\"reason\":\"COUNTER_TOO_OLD\",\"counter\":30,\"max_counter\":100}]}"
  },
  {
    "id": "case04_cryptokey_inner_ip_spoofing",
    "description": "피어의 AllowedIPs 범위를 벗어난 내부 출발지 IP 패킷 위조 주입 공격에 대한 암호키 라우팅 방어",
    "input": "{\"config\": {\"replay_window_size\": 64, \"rekey_after_time_s\": 120.0, \"rekey_after_packets\": 500, \"reject_after_time_s\": 180.0}, \"peers\": [{\"peer_id\": \"peer_partner_a\", \"public_key\": \"pk_pa\", \"allowed_ips\": [\"10.10.1.0/24\"], \"endpoint\": \"203.0.113.88:51820\"}], \"events\": [{\"type\": \"HANDSHAKE\", \"time_s\": 0.0, \"peer_id\": \"peer_partner_a\", \"session_id\": \"sess_pa_01\"}, {\"type\": \"RX\", \"time_s\": 1.0, \"src_endpoint\": \"203.0.113.88:51820\", \"inner_src_ip\": \"10.10.1.15\", \"inner_dst_ip\": \"10.0.0.1\", \"counter\": 1, \"session_id\": \"sess_pa_01\"}, {\"type\": \"RX\", \"time_s\": 2.0, \"src_endpoint\": \"203.0.113.88:51820\", \"inner_src_ip\": \"10.99.99.99\", \"inner_dst_ip\": \"10.0.0.1\", \"counter\": 2, \"session_id\": \"sess_pa_01\"}, {\"type\": \"RX\", \"time_s\": 3.0, \"src_endpoint\": \"203.0.113.88:51820\", \"inner_src_ip\": \"192.168.1.100\", \"inner_dst_ip\": \"10.0.0.1\", \"counter\": 3, \"session_id\": \"sess_pa_01\"}]}",
    "expected_output": "{\"metrics\":{\"tx_forwarded\":0,\"rx_accepted\":1,\"dropped_unroutable\":0,\"dropped_spoofed_src\":2,\"dropped_replay_duplicate\":0,\"dropped_counter_too_old\":0,\"rekey_handshakes\":1,\"endpoint_roaming_updates\":0},\"peer_summaries\":{\"peer_partner_a\":{\"current_endpoint\":\"203.0.113.88:51820\",\"active_session_id\":\"sess_pa_01\",\"tx_packets\":0,\"rx_packets\":1,\"rx_max_counter\":1,\"rekey_count\":1}},\"diagnostics\":{\"status\":\"SECURITY_INCIDENT_SPOOF\",\"anomalies\":[\"CRYPTOKEY_ROUTING_SPOOF_ATTEMPT\"]},\"event_log_sample\":[{\"time_s\":0.0,\"event\":\"HANDSHAKE_ESTABLISHED\",\"peer_id\":\"peer_partner_a\",\"session_id\":\"sess_pa_01\"},{\"time_s\":1.0,\"event\":\"RX_ACCEPT\",\"peer_id\":\"peer_partner_a\",\"inner_src_ip\":\"10.10.1.15\",\"inner_dst_ip\":\"10.0.0.1\",\"counter\":1},{\"time_s\":2.0,\"event\":\"RX_DROP\",\"reason\":\"CRYPT_KEY_ROUTING_SPOOFED_SRC\",\"peer_id\":\"peer_partner_a\",\"inner_src_ip\":\"10.99.99.99\"},{\"time_s\":3.0,\"event\":\"RX_DROP\",\"reason\":\"CRYPT_KEY_ROUTING_SPOOFED_SRC\",\"peer_id\":\"peer_partner_a\",\"inner_src_ip\":\"192.168.1.100\"}]}"
