    "input": "{\"config\":{\"mds_ranks\":2},\"operations\":[{\"op\":\"CREATE_INODE\",\"path\":\"/data.bin\",\"type\":\"FILE\",\"size\":100},{\"op\":\"REQUEST_CAP\",\"client_id\":\"writer_1\",\"path\":\"/data.bin\",\"cap_type\":\"WRITE\"},{\"op\":\"WRITE_DATA\",\"client_id\":\"writer_1\",\"path\":\"/data.bin\",\"new_size\":5000},{\"op\":\"REQUEST_CAP\",\"client_id\":\"reader_1\",\"path\":\"/data.bin\",\"cap_type\":\"READ\"}]}",
