[
  {
    "id": 1,
    "description": "안전 리스 최적 읽기 (Optimal Safe Bounded Lease Read) - 정상 클록 상태에서 5건의 조회를 0.5ms 로컬 캐시로 초고속 처리",
    "input": "{\n  \"system\": {\n    \"read_policy\": \"SAFE_BOUNDED_LEASE\",\n    \"lease_duration_ms\": 500.0,\n    \"clock_drift_max_tolerance_ms\": 50.0,\n    \"quorum_heartbeat_rtt_ms\": 20.0,\n    \"local_read_latency_ms\": 0.5\n  },\n  \"workload\": [\n    {\n      \"op\": \"LEASE_RENEW\",\n      \"wallclock_ms\": 0.0,\n      \"leader_id\": \"node_1\",\n      \"term\": 1\n    },\n    {\n      \"op\": \"WRITE\",\n      \"wallclock_ms\": 50.0,\n      \"leader_id\": \"node_1\",\n      \"term\": 1,\n      \"key\": \"k1\",\n      \"value\": \"v100\"\n    },\n    {\n      \"op\": \"READ\",\n      \"wallclock_ms\": 100.0,\n      \"node_id\": \"node_1\",\n      \"key\": \"k1\"\n    },\n    {\n      \"op\": \"READ\",\n      \"wallclock_ms\": 150.0,\n      \"node_id\": \"node_1\",\n      \"key\": \"k1\"\n    },\n    {\n      \"op\": \"WRITE\",\n      \"wallclock_ms\": 200.0,\n      \"leader_id\": \"node_1\",\n      \"term\": 1,\n      \"key\": \"k2\",\n      \"value\": \"v200\"\n    },\n    {\n      \"op\": \"READ\",\n      \"wallclock_ms\": 250.0,\n      \"node_id\": \"node_1\",\n      \"key\": \"k2\"\n    },\n    {\n      \"op\": \"READ\",\n      \"wallclock_ms\": 300.0,\n      \"node_id\": \"node_1\",\n      \"key\": \"k1\"\n    },\n    {\n      \"op\": \"READ\",\n      \"wallclock_ms\": 350.0,\n      \"node_id\": \"node_1\",\n      \"key\": \"k2\"\n    }\n  ]\n}",
    "output": "{\n  \"status\": \"SUCCESS\",\n  \"summary\": {\n    \"read_policy\": \"SAFE_BOUNDED_LEASE\",\n    \"total_reads\": 5,\n    \"stale_reads\": 0,\n    \"stale_read_rate\": 0.0,\n    \"local_lease_reads\": 5,\n    \"quorum_reads\": 0,\n    \"lease_read_ratio\": 1.0,\n    \"average_latency_ms\": 0.5\n  },\n  \"metrics\": {\n    \"total_reads\": 5,\n    \"stale_reads\": 0,\n    \"stale_read_rate\": 0.0,\n    \"local_lease_reads\": 5,\n    \"quorum_reads\": 0,\n    \"lease_read_ratio\": 1.0,\n    \"average_latency_ms\": 0.5,\n    \"verdict\": \"OPTIMAL_SAFE_BOUNDED_LEASE\"\n  },\n  \"sample_reads\": [\n    {\n      \"wallclock_ms\": 100.0,\n      \"node_id\": \"node_1\",\n      \"key\": \"k1\",\n      \"read_value\": \"v100\",\n      \"expected_true_value\": \"v100\",\n      \"read_type\": \"SAFE_LOCAL_LEASE\",\n      \"is_stale\": false,\n      \"latency_ms\": 0.5\n    },\n    {\n      \"wallclock_ms\": 150.0,\n      \"node_id\": \"node_1\",\n      \"key\": \"k1\",\n      \"read_value\": \"v100\",\n      \"expected_true_value\": \"v100\",\n      \"read_type\": \"SAFE_LOCAL_LEASE\",\n      \"is_stale\": false,\n      \"latency_ms\": 0.5\n    },\n    {\n      \"wallclock_ms\": 250.0,\n      \"node_id\": \"node_1\",\n      \"key\": \"k2\",\n      \"read_value\": \"v200\",\n      \"expected_true_value\": \"v200\",\n      \"read_type\": \"SAFE_LOCAL_LEASE\",\n      \"is_stale\": false,\n      \"latency_ms\": 0.5\n    },\n    {\n      \"wallclock_ms\": 300.0,\n      \"node_id\": \"node_1\",\n      \"key\": \"k1\",\n      \"read_value\": \"v100\",\n      \"expected_true_value\": \"v100\",\n      \"read_type\": \"SAFE_LOCAL_LEASE\",\n      \"is_stale\": false,\n      \"latency_ms\": 0.5\n    },\n    {\n      \"wallclock_ms\": 350.0,\n      \"node_id\": \"node_1\",\n      \"key\": \"k2\",\n      \"read_value\": \"v200\",\n      \"expected_true_value\": \"v200\",\n      \"read_type\": \"SAFE_LOCAL_LEASE\",\n      \"is_stale\": false,\n      \"latency_ms\": 0.5\n    }\n  ]\n}"
  },
  {
    "id": 2,
    "description": "나이브 월클록 리스 클록 드리프트 선형성 파괴 참사 (Naive Lease Stale Read Disaster) - 폐위된 구 리더가 드리프트로 인해 오래된 값 반환",
    "input": "{\n  \"system\": {\n    \"read_policy\": \"NAIVE_WALLCLOCK_LEASE\",\n    \"lease_duration_ms\": 500.0,\n    \"clock_drift_max_tolerance_ms\": 50.0,\n    \"quorum_heartbeat_rtt_ms\": 20.0,\n    \"local_read_latency_ms\": 0.5\n  },\n  \"workload\": [\n    {\n      \"op\": \"LEASE_RENEW\",\n      \"wallclock_ms\": 0.0,\n      \"leader_id\": \"node_1\",\n      \"term\": 1\n    },\n    {\n      \"op\": \"WRITE\",\n      \"wallclock_ms\": 100.0,\n      \"leader_id\": \"node_1\",\n      \"term\": 1,\n      \"key\": \"balance\",\n      \"value\": 1000\n    },\n    {\n      \"op\": \"READ\",\n      \"wallclock_ms\": 200.0,\n      \"node_id\": \"node_1\",\n      \"key\": \"balance\"\n    },\n    {\n      \"op\": \"SET_CLOCK_DRIFT\",\n      \"wallclock_ms\": 400.0,\n      \"node_id\": \"node_1\",\n      \"drift_ms\": -150.0\n    },\n    {\n      \"op\": \"NEW_LEADER_ELECTED\",\n      \"wallclock_ms\": 520.0,\n      \"new_leader_id\": \"node_2\",\n      \"term\": 2\n    },\n    {\n      \"op\": \"WRITE\",\n      \"wallclock_ms\": 530.0,\n      \"leader_id\": \"node_2\",\n      \"term\": 2,\n      \"key\": \"balance\",\n      \"value\": 5000\n    },\n    {\n      \"op\": \"READ\",\n      \"wallclock_ms\": 540.0,\n      \"node_id\": \"node_1\",\n      \"key\": \"balance\"\n    }\n  ]\n}",
    "output": "{\n  \"status\": \"FAILED\",\n  \"summary\": {\n    \"read_policy\": \"NAIVE_WALLCLOCK_LEASE\",\n    \"total_reads\": 2,\n    \"stale_reads\": 1,\n    \"stale_read_rate\": 0.5,\n    \"local_lease_reads\": 2,\n    \"quorum_reads\": 0,\n    \"lease_read_ratio\": 1.0,\n    \"average_latency_ms\": 0.5\n  },\n  \"metrics\": {\n    \"total_reads\": 2,\n    \"stale_reads\": 1,\n    \"stale_read_rate\": 0.5,\n    \"local_lease_reads\": 2,\n    \"quorum_reads\": 0,\n    \"lease_read_ratio\": 1.0,\n    \"average_latency_ms\": 0.5,\n    \"verdict\": \"STALE_READ_LINEARIZABILITY_VIOLATION\"\n  },\n  \"sample_reads\": [\n    {\n      \"wallclock_ms\": 200.0,\n      \"node_id\": \"node_1\",\n      \"key\": \"balance\",\n      \"read_value\": 1000,\n      \"expected_true_value\": 1000,\n      \"read_type\": \"LOCAL_LEASE\",\n      \"is_stale\": false,\n      \"latency_ms\": 0.5\n    },\n    {\n      \"wallclock_ms\": 540.0,\n      \"node_id\": \"node_1\",\n      \"key\": \"balance\",\n      \"read_value\": 1000,\n      \"expected_true_value\": 5000,\n      \"read_type\": \"STALE_LOCAL_LEASE_ANOMALY\",\n      \"is_stale\": true,\n      \"latency_ms\": 0.5\n    }\n  ]\n}"
  },
  {
    "id": 3,
    "description": "엄격한 쿼럼 ReadIndex 안전 읽기 (Strict ReadIndex Quorum) - 항상 쿼럼 하트비트를 검증하여 100% 선형성 보장 및 0건의 구 데이터 읽기",
    "input": "{\n  \"system\": {\n    \"read_policy\": \"STRICT_READ_INDEX_QUORUM\",\n    \"lease_duration_ms\": 500.0,\n    \"clock_drift_max_tolerance_ms\": 50.0,\n    \"quorum_heartbeat_rtt_ms\": 20.0,\n    \"local_read_latency_ms\": 0.5\n  },\n  \"workload\": [\n    {\n      \"op\": \"LEASE_RENEW\",\n      \"wallclock_ms\": 0.0,\n      \"leader_id\": \"node_1\",\n      \"term\": 1\n    },\n    {\n      \"op\": \"WRITE\",\n      \"wallclock_ms\": 50.0,\n      \"leader_id\": \"node_1\",\n      \"term\": 1,\n      \"key\": \"tx_status\",\n      \"value\": \"COMMITTED\"\n    },\n    {\n      \"op\": \"READ\",\n      \"wallclock_ms\": 100.0,\n      \"node_id\": \"node_1\",\n      \"key\": \"tx_status\"\n    },\n    {\n      \"op\": \"READ\",\n      \"wallclock_ms\": 200.0,\n      \"node_id\": \"node_1\",\n      \"key\": \"tx_status\"\n    },\n    {\n      \"op\": \"NEW_LEADER_ELECTED\",\n      \"wallclock_ms\": 510.0,\n      \"new_leader_id\": \"node_2\",\n      \"term\": 2\n    },\n    {\n      \"op\": \"WRITE\",\n      \"wallclock_ms\": 520.0,\n      \"leader_id\": \"node_2\",\n      \"term\": 2,\n      \"key\": \"tx_status\",\n      \"value\": \"SETTLED\"\n    },\n    {\n      \"op\": \"READ\",\n      \"wallclock_ms\": 530.0,\n      \"node_id\": \"node_1\",\n      \"key\": \"tx_status\"\n    },\n    {\n      \"op\": \"READ\",\n      \"wallclock_ms\": 540.0,\n      \"node_id\": \"node_2\",\n      \"key\": \"tx_status\"\n    }\n  ]\n}",
    "output": "{\n  \"status\": \"SUCCESS\",\n  \"summary\": {\n    \"read_policy\": \"STRICT_READ_INDEX_QUORUM\",\n    \"total_reads\": 4,\n    \"stale_reads\": 0,\n    \"stale_read_rate\": 0.0,\n    \"local_lease_reads\": 0,\n    \"quorum_reads\": 4,\n    \"lease_read_ratio\": 0.0,\n    \"average_latency_ms\": 20.5\n  },\n  \"metrics\": {\n    \"total_reads\": 4,\n    \"stale_reads\": 0,\n    \"stale_read_rate\": 0.0,\n    \"local_lease_reads\": 0,\n    \"quorum_reads\": 4,\n    \"lease_read_ratio\": 0.0,\n    \"average_latency_ms\": 20.5,\n    \"verdict\": \"LINEARIZABLE_QUORUM_HEARTBEAT_OVERHEAD\"\n  },\n  \"sample_reads\": [\n    {\n      \"wallclock_ms\": 100.0,\n      \"node_id\": \"node_1\",\n      \"key\": \"tx_status\",\n      \"read_value\": \"COMMITTED\",\n      \"expected_true_value\": \"COMMITTED\",\n      \"read_type\": \"QUORUM_READ_INDEX\",\n      \"is_stale\": false,\n      \"latency_ms\": 20.5\n    },\n    {\n      \"wallclock_ms\": 200.0,\n      \"node_id\": \"node_1\",\n      \"key\": \"tx_status\",\n      \"read_value\": \"COMMITTED\",\n      \"expected_true_value\": \"COMMITTED\",\n      \"read_type\": \"QUORUM_READ_INDEX\",\n      \"is_stale\": false,\n      \"latency_ms\": 20.5\n    },\n    {\n      \"wallclock_ms\": 530.0,\n      \"node_id\": \"node_1\",\n      \"key\": \"tx_status\",\n      \"read_value\": \"SETTLED\",\n      \"expected_true_value\": \"SETTLED\",\n      \"read_type\": \"QUORUM_READ_INDEX\",\n      \"is_stale\": false,\n      \"latency_ms\": 20.5\n    },\n    {\n      \"wallclock_ms\": 540.0,\n      \"node_id\": \"node_2\",\n      \"key\": \"tx_status\",\n      \"read_value\": \"SETTLED\",\n      \"expected_true_value\": \"SETTLED\",\n      \"read_type\": \"QUORUM_READ_INDEX\",\n      \"is_stale\": false,\n      \"latency_ms\": 20.5\n    }\n  ]\n}"
  },
  {
    "id": 4,
    "description": "허용 오차 이내 미세 드리프트 안전 로컬 읽기 (Minor Drift Within Tolerance) - 30ms 오차는 안전 마진(50ms) 내이므로 0.5ms 로컬 처리 유지",
    "input": "{\n  \"system\": {\n    \"read_policy\": \"SAFE_BOUNDED_LEASE\",\n    \"lease_duration_ms\": 500.0,\n    \"clock_drift_max_tolerance_ms\": 50.0,\n    \"quorum_heartbeat_rtt_ms\": 20.0,\n    \"local_read_latency_ms\": 0.5\n  },\n  \"workload\": [\n    {\n      \"op\": \"LEASE_RENEW\",\n      \"wallclock_ms\": 0.0,\n      \"leader_id\": \"node_1\",\n      \"term\": 1\n    },\n    {\n      \"op\": \"SET_CLOCK_DRIFT\",\n      \"wallclock_ms\": 50.0,\n      \"node_id\": \"node_1\",\n      \"drift_ms\": 30.0\n    },\n    {\n      \"op\": \"WRITE\",\n      \"wallclock_ms\": 100.0,\n      \"leader_id\": \"node_1\",\n      \"term\": 1,\n      \"key\": \"cfg\",\n      \"value\": \"A\"\n    },\n    {\n      \"op\": \"READ\",\n      \"wallclock_ms\": 150.0,\n      \"node_id\": \"node_1\",\n      \"key\": \"cfg\"\n    },\n    {\n      \"op\": \"READ\",\n      \"wallclock_ms\": 250.0,\n      \"node_id\": \"node_1\",\n      \"key\": \"cfg\"\n    }\n  ]\n}",
    "output": "{\n  \"status\": \"SUCCESS\",\n  \"summary\": {\n    \"read_policy\": \"SAFE_BOUNDED_LEASE\",\n    \"total_reads\": 2,\n    \"stale_reads\": 0,\n    \"stale_read_rate\": 0.0,\n    \"local_lease_reads\": 2,\n    \"quorum_reads\": 0,\n    \"lease_read_ratio\": 1.0,\n    \"average_latency_ms\": 0.5\n  },\n  \"metrics\": {\n    \"total_reads\": 2,\n    \"stale_reads\": 0,\n    \"stale_read_rate\": 0.0,\n    \"local_lease_reads\": 2,\n    \"quorum_reads\": 0,\n    \"lease_read_ratio\": 1.0,\n    \"average_latency_ms\": 0.5,\n    \"verdict\": \"OPTIMAL_SAFE_BOUNDED_LEASE\"\n  },\n  \"sample_reads\": [\n    {\n      \"wallclock_ms\": 150.0,\n      \"node_id\": \"node_1\",\n      \"key\": \"cfg\",\n      \"read_value\": \"A\",\n      \"expected_true_value\": \"A\",\n      \"read_type\": \"SAFE_LOCAL_LEASE\",\n      \"is_stale\": false,\n      \"latency_ms\": 0.5\n    },\n    {\n      \"wallclock_ms\": 250.0,\n      \"node_id\": \"node_1\",\n      \"key\": \"cfg\",\n      \"read_value\": \"A\",\n      \"expected_true_value\": \"A\",\n      \"read_type\": \"SAFE_LOCAL_LEASE\",\n      \"is_stale\": false,\n      \"latency_ms\": 0.5\n    }\n  ]\n}"
  },
  {
    "id": 5,
    "description": "오차 초과 시 자동 쿼럼 폴백 방어 (Safety Margin Exceeded Auto-Fallback) - 80ms 드리프트 발생 시 즉각 ReadIndex 쿼럼으로 전환하여 최신값(99) 보장",
    "input": "{\n  \"system\": {\n    \"read_policy\": \"SAFE_BOUNDED_LEASE\",\n    \"lease_duration_ms\": 500.0,\n    \"clock_drift_max_tolerance_ms\": 50.0,\n    \"quorum_heartbeat_rtt_ms\": 20.0,\n    \"local_read_latency_ms\": 0.5\n  },\n  \"workload\": [\n    {\n      \"op\": \"LEASE_RENEW\",\n      \"wallclock_ms\": 0.0,\n      \"leader_id\": \"node_1\",\n      \"term\": 1\n    },\n    {\n      \"op\": \"WRITE\",\n      \"wallclock_ms\": 50.0,\n      \"leader_id\": \"node_1\",\n      \"term\": 1,\n      \"key\": \"x\",\n      \"value\": 10\n    },\n    {\n      \"op\": \"SET_CLOCK_DRIFT\",\n      \"wallclock_ms\": 100.0,\n      \"node_id\": \"node_1\",\n      \"drift_ms\": -80.0\n    },\n    {\n      \"op\": \"READ\",\n      \"wallclock_ms\": 150.0,\n      \"node_id\": \"node_1\",\n      \"key\": \"x\"\n    },\n    {\n      \"op\": \"NEW_LEADER_ELECTED\",\n      \"wallclock_ms\": 510.0,\n      \"new_leader_id\": \"node_2\",\n      \"term\": 2\n    },\n    {\n      \"op\": \"WRITE\",\n      \"wallclock_ms\": 520.0,\n      \"leader_id\": \"node_2\",\n      \"term\": 2,\n      \"key\": \"x\",\n      \"value\": 99\n    },\n    {\n      \"op\": \"READ\",\n      \"wallclock_ms\": 530.0,\n      \"node_id\": \"node_1\",\n      \"key\": \"x\"\n    }\n  ]\n}",
    "output": "{\n  \"status\": \"SUCCESS\",\n  \"summary\": {\n    \"read_policy\": \"SAFE_BOUNDED_LEASE\",\n    \"total_reads\": 2,\n    \"stale_reads\": 0,\n    \"stale_read_rate\": 0.0,\n    \"local_lease_reads\": 0,\n    \"quorum_reads\": 2,\n    \"lease_read_ratio\": 0.0,\n    \"average_latency_ms\": 20.5\n  },\n  \"metrics\": {\n    \"total_reads\": 2,\n    \"stale_reads\": 0,\n    \"stale_read_rate\": 0.0,\n    \"local_lease_reads\": 0,\n    \"quorum_reads\": 2,\n    \"lease_read_ratio\": 0.0,\n    \"average_latency_ms\": 20.5,\n    \"verdict\": \"OPTIMAL_SAFE_BOUNDED_LEASE\"\n  },\n  \"sample_reads\": [\n    {\n      \"wallclock_ms\": 150.0,\n      \"node_id\": \"node_1\",\n      \"key\": \"x\",\n      \"read_value\": 10,\n      \"expected_true_value\": 10,\n      \"read_type\": \"SAFE_FALLBACK_QUORUM\",\n      \"is_stale\": false,\n      \"latency_ms\": 20.5\n    },\n    {\n      \"wallclock_ms\": 530.0,\n      \"node_id\": \"node_1\",\n      \"key\": \"x\",\n      \"read_value\": 99,\n      \"expected_true_value\": 99,\n      \"read_type\": \"SAFE_FALLBACK_QUORUM\",\n      \"is_stale\": false,\n      \"latency_ms\": 20.5\n    }\n  ]\n}"
  },
  {
    "id": 6,
    "description": "다중 키 복합 읽기/쓰기 인터리빙 워크로드 (Multi-Key Interleaved Workload) - 다중 환율 자산 키의 실시간 갱신과 100% 로컬 캐시 적중 검증",
    "input": "{\n  \"system\": {\n    \"read_policy\": \"SAFE_BOUNDED_LEASE\",\n    \"lease_duration_ms\": 600.0,\n    \"clock_drift_max_tolerance_ms\": 60.0,\n    \"quorum_heartbeat_rtt_ms\": 15.0,\n    \"local_read_latency_ms\": 0.3\n  },\n  \"workload\": [\n    {\n      \"op\": \"LEASE_RENEW\",\n      \"wallclock_ms\": 0.0,\n      \"leader_id\": \"node_1\",\n      \"term\": 1\n    },\n    {\n      \"op\": \"WRITE\",\n      \"wallclock_ms\": 20.0,\n      \"leader_id\": \"node_1\",\n      \"term\": 1,\n      \"key\": \"stock_krw\",\n      \"value\": 100\n    },\n    {\n      \"op\": \"WRITE\",\n      \"wallclock_ms\": 40.0,\n      \"leader_id\": \"node_1\",\n      \"term\": 1,\n      \"key\": \"stock_usd\",\n      \"value\": 50\n    },\n    {\n      \"op\": \"READ\",\n      \"wallclock_ms\": 60.0,\n      \"node_id\": \"node_1\",\n      \"key\": \"stock_krw\"\n    },\n    {\n      \"op\": \"READ\",\n      \"wallclock_ms\": 80.0,\n      \"node_id\": \"node_1\",\n      \"key\": \"stock_usd\"\n    },\n    {\n      \"op\": \"WRITE\",\n      \"wallclock_ms\": 100.0,\n      \"leader_id\": \"node_1\",\n      \"term\": 1,\n      \"key\": \"stock_krw\",\n      \"value\": 90\n    },\n    {\n      \"op\": \"READ\",\n      \"wallclock_ms\": 120.0,\n      \"node_id\": \"node_1\",\n      \"key\": \"stock_krw\"\n    },\n    {\n      \"op\": \"READ\",\n      \"wallclock_ms\": 140.0,\n      \"node_id\": \"node_1\",\n      \"key\": \"stock_usd\"\n    }\n  ]\n}",
    "output": "{\n  \"status\": \"SUCCESS\",\n  \"summary\": {\n    \"read_policy\": \"SAFE_BOUNDED_LEASE\",\n    \"total_reads\": 4,\n    \"stale_reads\": 0,\n    \"stale_read_rate\": 0.0,\n    \"local_lease_reads\": 4,\n    \"quorum_reads\": 0,\n    \"lease_read_ratio\": 1.0,\n    \"average_latency_ms\": 0.3\n  },\n  \"metrics\": {\n    \"total_reads\": 4,\n    \"stale_reads\": 0,\n    \"stale_read_rate\": 0.0,\n    \"local_lease_reads\": 4,\n    \"quorum_reads\": 0,\n    \"lease_read_ratio\": 1.0,\n    \"average_latency_ms\": 0.3,\n    \"verdict\": \"OPTIMAL_SAFE_BOUNDED_LEASE\"\n  },\n  \"sample_reads\": [\n    {\n      \"wallclock_ms\": 60.0,\n      \"node_id\": \"node_1\",\n      \"key\": \"stock_krw\",\n      \"read_value\": 100,\n      \"expected_true_value\": 100,\n      \"read_type\": \"SAFE_LOCAL_LEASE\",\n      \"is_stale\": false,\n      \"latency_ms\": 0.3\n    },\n    {\n      \"wallclock_ms\": 80.0,\n      \"node_id\": \"node_1\",\n      \"key\": \"stock_usd\",\n      \"read_value\": 50,\n      \"expected_true_value\": 50,\n      \"read_type\": \"SAFE_LOCAL_LEASE\",\n      \"is_stale\": false,\n      \"latency_ms\": 0.3\n    },\n    {\n      \"wallclock_ms\": 120.0,\n      \"node_id\": \"node_1\",\n      \"key\": \"stock_krw\",\n      \"read_value\": 90,\n      \"expected_true_value\": 90,\n      \"read_type\": \"SAFE_LOCAL_LEASE\",\n      \"is_stale\": false,\n      \"latency_ms\": 0.3\n    },\n    {\n      \"wallclock_ms\": 140.0,\n      \"node_id\": \"node_1\",\n      \"key\": \"stock_usd\",\n      \"read_value\": 50,\n      \"expected_true_value\": 50,\n      \"read_type\": \"SAFE_LOCAL_LEASE\",\n      \"is_stale\": false,\n      \"latency_ms\": 0.3\n    }\n  ]\n}"
