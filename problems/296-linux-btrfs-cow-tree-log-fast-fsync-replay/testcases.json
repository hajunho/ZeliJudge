    "input": "{\"config\": {}, \"initial_files\": [{\"inode_id\": 301, \"size\": 0}], \"events\": [{\"type\": \"WRITE\", \"time_us\": 10.0, \"inode_id\": 301, \"offset\": 0, \"len\": 4096, \"block\": 70001}, {\"type\": \"COMMIT_TRANSACTION\", \"time_us\": 20.0}, {\"type\": \"CRASH\", \"time_us\": 30.0}]}",
