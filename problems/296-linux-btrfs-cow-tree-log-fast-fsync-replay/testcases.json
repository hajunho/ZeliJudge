    "input": "{\"config\": {}, \"initial_files\": [{\"inode_id\": 201, \"size\": 0}], \"events\": [{\"type\": \"WRITE\", \"time_us\": 10.0, \"inode_id\": 201, \"offset\": 0, \"len\": 4096, \"block\": 60001}, {\"type\": \"CRASH\", \"time_us\": 20.0}]}",
