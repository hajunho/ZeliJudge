    "description": "BPF LSM evaluation scenario #1: block_shadow_and_pki",
    "input": "{\"policies\": [{\"policy_id\": \"block_shadow_and_pki\", \"hook\": \"bpf_lsm_file_open\", \"match\": {\"cgroup_pattern\": \"k8s-pod-*\", \"target_path_pattern\": \"/etc/shadow*\", \"flags\": [\"O_RDONLY\", \"O_RDWR\"]}, \"action\": \"BLOCK_EACCES\", \"severity\": \"CRITICAL\"}, {\"policy_id\": \"block_k8s_certs\", \"hook\": \"bpf_lsm_file_open\", \"match\": {\"cgroup_pattern\": \"k8s-pod-*\", \"target_path_pattern\": \"/etc/kubernetes/pki/*\"}, \"action\": \"BLOCK_EPERM\", \"severity\": \"HIGH\"}], \"processes\": {\"100\": {\"comm\": \"web\", \"binary_path\": \"/app/web\", \"ppid\": 1, \"cgroup\": \"k8s-pod-frontend\", \"uid\": 1000, \"gid\": 1000}}, \"events\": [{\"event_id\": \"ev1\", \"pid\": 100, \"hook\": \"bpf_lsm_file_open\", \"details\": {\"path\": \"/etc/shadow\", \"flags\": [\"O_RDONLY\"]}}, {\"event_id\": \"ev2\", \"pid\": 100, \"hook\": \"bpf_lsm_file_open\", \"details\": {\"path\": \"/etc/kubernetes/pki/ca.key\", \"flags\": [\"O_RDONLY\"]}}, {\"event_id\": \"ev3\", \"pid\": 100, \"hook\": \"bpf_lsm_file_open\", \"details\": {\"path\": \"/app/config.json\", \"flags\": [\"O_RDONLY\"]}}]}",
