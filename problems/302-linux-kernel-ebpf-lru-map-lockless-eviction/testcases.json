[
  {
    "id": "TC-01",
    "description": "Basic Inactive Eviction without Active Rotation (Simple LRU capacity limit)",
    "input": "{\"max_entries\": 3, \"num_cpus\": 2, \"commands\": [{\"op\": \"UPDATE\", \"cpu\": 0, \"key\": \"k1\", \"value\": 10}, {\"op\": \"UPDATE\", \"cpu\": 0, \"key\": \"k2\", \"value\": 20}, {\"op\": \"UPDATE\", \"cpu\": 1, \"key\": \"k3\", \"value\": 30}, {\"op\": \"UPDATE\", \"cpu\": 0, \"key\": \"k4\", \"value\": 40}]}",
    "expected_output": "{\"command_results\": [{\"op\": \"UPDATE\", \"key\": \"k1\", \"result\": {\"status\": \"INSERTED\", \"key\": \"k1\", \"evicted\": null}}, {\"op\": \"UPDATE\", \"key\": \"k2\", \"result\": {\"status\": \"INSERTED\", \"key\": \"k2\", \"evicted\": null}}, {\"op\": \"UPDATE\", \"key\": \"k3\", \"result\": {\"status\": \"INSERTED\", \"key\": \"k3\", \"evicted\": null}}, {\"op\": \"UPDATE\", \"key\": \"k4\", \"result\": {\"status\": \"INSERTED\", \"key\": \"k4\", \"evicted\": \"k1\"}}], \"final_state\": {\"total_entries\": 3, \"active_list\": [], \"inactive_list\": [\"k4\", \"k3\", \"k2\"], \"evicted_keys\": [\"k1\"], \"table_keys\": [\"k2\", \"k3\", \"k4\"]}}"
  },
  {
    "id": "TC-02",
    "description": "Active Bit Promotion via Lookup preventing eviction of referenced key",
    "input": "{\"max_entries\": 3, \"num_cpus\": 2, \"commands\": [{\"op\": \"UPDATE\", \"cpu\": 0, \"key\": \"A\", \"value\": 100}, {\"op\": \"UPDATE\", \"cpu\": 0, \"key\": \"B\", \"value\": 200}, {\"op\": \"UPDATE\", \"cpu\": 1, \"key\": \"C\", \"value\": 300}, {\"op\": \"LOOKUP\", \"cpu\": 1, \"key\": \"A\"}, {\"op\": \"UPDATE\", \"cpu\": 0, \"key\": \"D\", \"value\": 400}]}",
    "expected_output": "{\"command_results\": [{\"op\": \"UPDATE\", \"key\": \"A\", \"result\": {\"status\": \"INSERTED\", \"key\": \"A\", \"evicted\": null}}, {\"op\": \"UPDATE\", \"key\": \"B\", \"result\": {\"status\": \"INSERTED\", \"key\": \"B\", \"evicted\": null}}, {\"op\": \"UPDATE\", \"key\": \"C\", \"result\": {\"status\": \"INSERTED\", \"key\": \"C\", \"evicted\": null}}, {\"op\": \"LOOKUP\", \"key\": \"A\", \"result\": {\"found\": true, \"value\": 100}}, {\"op\": \"UPDATE\", \"key\": \"D\", \"result\": {\"status\": \"INSERTED\", \"key\": \"D\", \"evicted\": \"B\"}}], \"final_state\": {\"total_entries\": 3, \"active_list\": [\"A\"], \"inactive_list\": [\"D\", \"C\"], \"evicted_keys\": [\"B\"], \"table_keys\": [\"A\", \"C\", \"D\"]}}"
  },
  {
    "id": "TC-03",
    "description": "Multiple Lookups and Active List Balancing when Active exceeds Inactive",
    "input": "{\"max_entries\": 4, \"num_cpus\": 2, \"commands\": [{\"op\": \"UPDATE\", \"cpu\": 0, \"key\": \"k1\", \"value\": 1}, {\"op\": \"UPDATE\", \"cpu\": 1, \"key\": \"k2\", \"value\": 2}, {\"op\": \"UPDATE\", \"cpu\": 0, \"key\": \"k3\", \"value\": 3}, {\"op\": \"UPDATE\", \"cpu\": 1, \"key\": \"k4\", \"value\": 4}, {\"op\": \"LOOKUP\", \"cpu\": 0, \"key\": \"k1\"}, {\"op\": \"LOOKUP\", \"cpu\": 1, \"key\": \"k2\"}, {\"op\": \"LOOKUP\", \"cpu\": 0, \"key\": \"k3\"}, {\"op\": \"UPDATE\", \"cpu\": 0, \"key\": \"k5\", \"value\": 5}]}",
    "expected_output": "{\"command_results\": [{\"op\": \"UPDATE\", \"key\": \"k1\", \"result\": {\"status\": \"INSERTED\", \"key\": \"k1\", \"evicted\": null}}, {\"op\": \"UPDATE\", \"key\": \"k2\", \"result\": {\"status\": \"INSERTED\", \"key\": \"k2\", \"evicted\": null}}, {\"op\": \"UPDATE\", \"key\": \"k3\", \"result\": {\"status\": \"INSERTED\", \"key\": \"k3\", \"evicted\": null}}, {\"op\": \"UPDATE\", \"key\": \"k4\", \"result\": {\"status\": \"INSERTED\", \"key\": \"k4\", \"evicted\": null}}, {\"op\": \"LOOKUP\", \"key\": \"k1\", \"result\": {\"found\": true, \"value\": 1}}, {\"op\": \"LOOKUP\", \"key\": \"k2\", \"result\": {\"found\": true, \"value\": 2}}, {\"op\": \"LOOKUP\", \"key\": \"k3\", \"result\": {\"found\": true, \"value\": 3}}, {\"op\": \"UPDATE\", \"key\": \"k5\", \"result\": {\"status\": \"INSERTED\", \"key\": \"k5\", \"evicted\": \"k4\"}}], \"final_state\": {\"total_entries\": 4, \"active_list\": [\"k3\", \"k2\"], \"inactive_list\": [\"k5\", \"k1\"], \"evicted_keys\": [\"k4\"], \"table_keys\": [\"k1\", \"k2\", \"k3\", \"k5\"]}}"
  },
  {
    "id": "TC-04",
    "description": "Explicit Key Deletion and Reinsertion in Multi-CPU context",
    "input": "{\"max_entries\": 3, \"num_cpus\": 4, \"commands\": [{\"op\": \"UPDATE\", \"cpu\": 0, \"key\": \"x\", \"value\": 10}, {\"op\": \"UPDATE\", \"cpu\": 1, \"key\": \"y\", \"value\": 20}, {\"op\": \"UPDATE\", \"cpu\": 2, \"key\": \"z\", \"value\": 30}, {\"op\": \"DELETE\", \"cpu\": 3, \"key\": \"y\"}, {\"op\": \"UPDATE\", \"cpu\": 0, \"key\": \"w\", \"value\": 40}, {\"op\": \"LOOKUP\", \"cpu\": 1, \"key\": \"y\"}]}",
    "expected_output": "{\"command_results\": [{\"op\": \"UPDATE\", \"key\": \"x\", \"result\": {\"status\": \"INSERTED\", \"key\": \"x\", \"evicted\": null}}, {\"op\": \"UPDATE\", \"key\": \"y\", \"result\": {\"status\": \"INSERTED\", \"key\": \"y\", \"evicted\": null}}, {\"op\": \"UPDATE\", \"key\": \"z\", \"result\": {\"status\": \"INSERTED\", \"key\": \"z\", \"evicted\": null}}, {\"op\": \"DELETE\", \"key\": \"y\", \"result\": {\"deleted\": true}}, {\"op\": \"UPDATE\", \"key\": \"w\", \"result\": {\"status\": \"INSERTED\", \"key\": \"w\", \"evicted\": null}}, {\"op\": \"LOOKUP\", \"key\": \"y\", \"result\": {\"found\": false, \"value\": null}}], \"final_state\": {\"total_entries\": 3, \"active_list\": [], \"inactive_list\": [\"w\", \"z\", \"x\"], \"evicted_keys\": [], \"table_keys\": [\"w\", \"x\", \"z\"]}}"
  },
  {
    "id": "TC-05",
    "description": "Key In-place Value Update triggering Active flag set without eviction",
    "input": "{\"max_entries\": 3, \"num_cpus\": 2, \"commands\": [{\"op\": \"UPDATE\", \"cpu\": 0, \"key\": \"p1\", \"value\": 100}, {\"op\": \"UPDATE\", \"cpu\": 1, \"key\": \"p2\", \"value\": 200}, {\"op\": \"UPDATE\", \"cpu\": 0, \"key\": \"p1\", \"value\": 150}, {\"op\": \"UPDATE\", \"cpu\": 1, \"key\": \"p3\", \"value\": 300}, {\"op\": \"UPDATE\", \"cpu\": 0, \"key\": \"p4\", \"value\": 400}]}",
    "expected_output": "{\"command_results\": [{\"op\": \"UPDATE\", \"key\": \"p1\", \"result\": {\"status\": \"INSERTED\", \"key\": \"p1\", \"evicted\": null}}, {\"op\": \"UPDATE\", \"key\": \"p2\", \"result\": {\"status\": \"INSERTED\", \"key\": \"p2\", \"evicted\": null}}, {\"op\": \"UPDATE\", \"key\": \"p1\", \"result\": {\"status\": \"UPDATED\", \"key\": \"p1\", \"evicted\": null}}, {\"op\": \"UPDATE\", \"key\": \"p3\", \"result\": {\"status\": \"INSERTED\", \"key\": \"p3\", \"evicted\": null}}, {\"op\": \"UPDATE\", \"key\": \"p4\", \"result\": {\"status\": \"INSERTED\", \"key\": \"p4\", \"evicted\": \"p2\"}}], \"final_state\": {\"total_entries\": 3, \"active_list\": [\"p1\"], \"inactive_list\": [\"p4\", \"p3\"], \"evicted_keys\": [\"p2\"], \"table_keys\": [\"p1\", \"p3\", \"p4\"]}}"
  },
  {
    "id": "TC-06",
    "description": "Continuous Heavy Stream Eviction (Stress Test with 10 keys on capacity 4)",
    "input": "{\"max_entries\": 4, \"num_cpus\": 4, \"commands\": [{\"op\": \"UPDATE\", \"cpu\": 0, \"key\": \"v1\", \"value\": 1}, {\"op\": \"UPDATE\", \"cpu\": 1, \"key\": \"v2\", \"value\": 2}, {\"op\": \"UPDATE\", \"cpu\": 2, \"key\": \"v3\", \"value\": 3}, {\"op\": \"UPDATE\", \"cpu\": 3, \"key\": \"v4\", \"value\": 4}, {\"op\": \"UPDATE\", \"cpu\": 0, \"key\": \"v5\", \"value\": 5}, {\"op\": \"UPDATE\", \"cpu\": 1, \"key\": \"v6\", \"value\": 6}, {\"op\": \"UPDATE\", \"cpu\": 2, \"key\": \"v7\", \"value\": 7}, {\"op\": \"UPDATE\", \"cpu\": 3, \"key\": \"v8\", \"value\": 8}]}",
    "expected_output": "{\"command_results\": [{\"op\": \"UPDATE\", \"key\": \"v1\", \"result\": {\"status\": \"INSERTED\", \"key\": \"v1\", \"evicted\": null}}, {\"op\": \"UPDATE\", \"key\": \"v2\", \"result\": {\"status\": \"INSERTED\", \"key\": \"v2\", \"evicted\": null}}, {\"op\": \"UPDATE\", \"key\": \"v3\", \"result\": {\"status\": \"INSERTED\", \"key\": \"v3\", \"evicted\": null}}, {\"op\": \"UPDATE\", \"key\": \"v4\", \"result\": {\"status\": \"INSERTED\", \"key\": \"v4\", \"evicted\": null}}, {\"op\": \"UPDATE\", \"key\": \"v5\", \"result\": {\"status\": \"INSERTED\", \"key\": \"v5\", \"evicted\": \"v1\"}}, {\"op\": \"UPDATE\", \"key\": \"v6\", \"result\": {\"status\": \"INSERTED\", \"key\": \"v6\", \"evicted\": \"v2\"}}, {\"op\": \"UPDATE\", \"key\": \"v7\", \"result\": {\"status\": \"INSERTED\", \"key\": \"v7\", \"evicted\": \"v3\"}}, {\"op\": \"UPDATE\", \"key\": \"v8\", \"result\": {\"status\": \"INSERTED\", \"key\": \"v8\", \"evicted\": \"v4\"}}], \"final_state\": {\"total_entries\": 4, \"active_list\": [], \"inactive_list\": [\"v8\", \"v7\", \"v6\", \"v5\"], \"evicted_keys\": [\"v1\", \"v2\", \"v3\", \"v4\"], \"table_keys\": [\"v5\", \"v6\", \"v7\", \"v8\"]}}"
  },
  {
    "id": "TC-07",
    "description": "Interleaved Hot-Key Workload (Frequency retaining vs Cold eviction)",
    "input": "{\"max_entries\": 3, \"num_cpus\": 2, \"commands\": [{\"op\": \"UPDATE\", \"cpu\": 0, \"key\": \"hot\", \"value\": 999}, {\"op\": \"UPDATE\", \"cpu\": 0, \"key\": \"cold1\", \"value\": 1}, {\"op\": \"UPDATE\", \"cpu\": 1, \"key\": \"cold2\", \"value\": 2}, {\"op\": \"LOOKUP\", \"cpu\": 1, \"key\": \"hot\"}, {\"op\": \"UPDATE\", \"cpu\": 0, \"key\": \"cold3\", \"value\": 3}, {\"op\": \"LOOKUP\", \"cpu\": 0, \"key\": \"hot\"}, {\"op\": \"UPDATE\", \"cpu\": 1, \"key\": \"cold4\", \"value\": 4}, {\"op\": \"LOOKUP\", \"cpu\": 0, \"key\": \"hot\"}]}",
    "expected_output": "{\"command_results\": [{\"op\": \"UPDATE\", \"key\": \"hot\", \"result\": {\"status\": \"INSERTED\", \"key\": \"hot\", \"evicted\": null}}, {\"op\": \"UPDATE\", \"key\": \"cold1\", \"result\": {\"status\": \"INSERTED\", \"key\": \"cold1\", \"evicted\": null}}, {\"op\": \"UPDATE\", \"key\": \"cold2\", \"result\": {\"status\": \"INSERTED\", \"key\": \"cold2\", \"evicted\": null}}, {\"op\": \"LOOKUP\", \"key\": \"hot\", \"result\": {\"found\": true, \"value\": 999}}, {\"op\": \"UPDATE\", \"key\": \"cold3\", \"result\": {\"status\": \"INSERTED\", \"key\": \"cold3\", \"evicted\": \"cold1\"}}, {\"op\": \"LOOKUP\", \"key\": \"hot\", \"result\": {\"found\": true, \"value\": 999}}, {\"op\": \"UPDATE\", \"key\": \"cold4\", \"result\": {\"status\": \"INSERTED\", \"key\": \"cold4\", \"evicted\": \"cold2\"}}, {\"op\": \"LOOKUP\", \"key\": \"hot\", \"result\": {\"found\": true, \"value\": 999}}], \"final_state\": {\"total_entries\": 3, \"active_list\": [\"hot\"], \"inactive_list\": [\"cold4\", \"cold3\"], \"evicted_keys\": [\"cold1\", \"cold2\"], \"table_keys\": [\"cold3\", \"cold4\", \"hot\"]}}"
  },
  {
    "id": "TC-08",
    "description": "Edge Case: Single entry capacity map with alternating updates and lookups",
    "input": "{\"max_entries\": 1, \"num_cpus\": 2, \"commands\": [{\"op\": \"UPDATE\", \"cpu\": 0, \"key\": \"one\", \"value\": 1}, {\"op\": \"LOOKUP\", \"cpu\": 1, \"key\": \"one\"}, {\"op\": \"UPDATE\", \"cpu\": 1, \"key\": \"two\", \"value\": 2}, {\"op\": \"LOOKUP\", \"cpu\": 0, \"key\": \"one\"}, {\"op\": \"LOOKUP\", \"cpu\": 1, \"key\": \"two\"}]}",
    "expected_output": "{\"command_results\": [{\"op\": \"UPDATE\", \"key\": \"one\", \"result\": {\"status\": \"INSERTED\", \"key\": \"one\", \"evicted\": null}}, {\"op\": \"LOOKUP\", \"key\": \"one\", \"result\": {\"found\": true, \"value\": 1}}, {\"op\": \"UPDATE\", \"key\": \"two\", \"result\": {\"status\": \"INSERTED\", \"key\": \"two\", \"evicted\": null}}, {\"op\": \"LOOKUP\", \"key\": \"one\", \"result\": {\"found\": true, \"value\": 1}}, {\"op\": \"LOOKUP\", \"key\": \"two\", \"result\": {\"found\": true, \"value\": 2}}], \"final_state\": {\"total_entries\": 2, \"active_list\": [\"one\"], \"inactive_list\": [\"two\"], \"evicted_keys\": [], \"table_keys\": [\"one\", \"two\"]}}"
  }
