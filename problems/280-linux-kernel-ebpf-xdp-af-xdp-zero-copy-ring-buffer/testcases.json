    "expected_output": "{\"operations_log\": [{\"step\": 1, \"op\": \"USER_FILL_RING_ENQUEUE\", \"enqueued_count\": 4, \"enqueued_addrs\": [0, 2048, 4096, 6144], \"rejected_full_addrs\": []}, {\"step\": 2, \"op\": \"NIC_RECEIVE_PACKET\", \"packet_id\": \"http1\", \"action\": \"XDP_REDIRECT\", \"status\": \"ZERO_COPY_RX_DELIVERED\", \"assigned_chunk_addr\": 0}, {\"step\": 3, \"op\": \"NIC_RECEIVE_PACKET\", \"packet_id\": \"ddos1\", \"action\": \"XDP_DROP\", \"status\": \"DROPPED\"}, {\"step\": 4, \"op\": \"NIC_RECEIVE_PACKET\", \"packet_id\": \"ping1\", \"action\": \"XDP_TX\", \"status\": \"HAIRPIN_BOUNCE_TX\"}, {\"step\": 5, \"op\": \"NIC_RECEIVE_PACKET\", \"packet_id\": \"http2\", \"action\": \"XDP_REDIRECT\", \"status\": \"ZERO_COPY_RX_DELIVERED\", \"assigned_chunk_addr\": 2048}, {\"step\": 6, \"op\": \"USER_RX_RING_DEQUEUE\", \"dequeued_count\": 2, \"packets\": [{\"chunk_addr\": 0, \"packet_id\": \"http1\", \"len\": 256}, {\"chunk_addr\": 2048, \"packet_id\": \"http2\", \"len\": 256}]}, {\"step\": 7, \"op\": \"USER_TX_RING_ENQUEUE\", \"submitted_count\": 1, \"submitted\": [{\"chunk_addr\": 0, \"len\": 128}], \"rejected_full\": []}, {\"step\": 8, \"op\": \"KERNEL_TX_COMPLETION\", \"completed_count\": 1, \"completed_chunks\": [0]}, {\"step\": 9, \"op\": \"USER_COMPLETION_RING_DEQUEUE\", \"reclaimed_count\": 1, \"reclaimed_chunks\": [0]}], \"final_ring_states\": {\"fill_ring\": [4096, 6144], \"rx_ring\": [], \"tx_ring\": [], \"completion_ring\": []}, \"statistics\": {\"rx_total_packets\": 4, \"xdp_drop\": 1, \"xdp_pass\": 0, \"xdp_tx\": 1, \"xdp_redirect\": 2, \"fill_ring_empty_drops\": 0, \"rx_ring_full_drops\": 0, \"tx_submitted\": 1, \"tx_completed\": 1}}"
